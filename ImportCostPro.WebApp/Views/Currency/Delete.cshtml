@model ImportCostPro.Application.ViewModels.CurrencyViewModels.CurrencyViewModel
@{
    ViewData["Title"] = "Eliminar Moneda";
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-action="Index"
       class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver al listado
    </a>
    <h1 class="text-2xl font-bold text-gray-900 mt-2">Eliminar Moneda</h1>
    <p class="text-sm text-gray-500">¿Está seguro que desea eliminar esta moneda?</p>
</div>

<div class="max-w-2xl animate__animated animate__fadeInUp animate__faster">
    <div
        class="bg-white border border-red-100 rounded-2xl shadow-xl shadow-red-50/50 overflow-hidden hover:shadow-2xl transition-shadow duration-300">
        <div class="p-6 sm:p-8">
            <div
                class="flex items-start gap-4 mb-8 p-4 bg-red-50 rounded-xl border border-red-100 animate__animated animate__pulse animate__infinite animate__slow">
                <div class="p-2 bg-red-100 rounded-lg text-red-600">
                    <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-red-800">Confirmación Requerida</h3>
                    <p class="text-xs text-red-600 mt-1 leading-relaxed">
                        Se dispone a eliminar la moneda <span class="font-bold">@Model.Name (@Model.IsoCode)</span>.
                        No se puede eliminar esta moneda porque está asociada a otros registros del sistema.
                    </p>
                </div>
            </div>

            <div class="space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div>
                        <span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Nombre de la
                            Moneda</span>
                            <span class="text-lg font-semibold text-gray-900">@Model.Name</span>
                        </div>
                        <div>
                            <span
                            class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Símbolo</span>
                            <span class="text-lg font-mono font-bold text-blue-600">@Model.Symbol</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                        <div>
                            <span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Código
                                ISO</span>
                                <span
                                    class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-blue-50 text-blue-700 border border-blue-100">
                                    @Model.IsoCode
                                </span>
                            </div>
                            <div>
                                <span class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Tipo de
                                    Moneda</span>
                                    @if (Model.IsLocalCurrency)
                                    {
                                        <span
                                            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest bg-linear-to-r from-amber-100 to-yellow-100 text-amber-800 border border-amber-200 shadow-sm">
                                            <i data-lucide="gem" class="w-3.5 h-3.5 fill-amber-500 text-amber-600"></i>
                                            Local Base
                                        </span>
                                    }
                                    else
                                    {
                                        <span
                                            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gray-100 text-gray-600 border border-gray-200 shadow-sm">
                                            <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                                            Extranjera
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-10 pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                            <a asp-action="Index"
                               class="px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition-all cursor-pointer">
                                Cancelar
                            </a>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="Id" />
                                <button type="submit"
                                        class="inline-flex items-center justify-center gap-2.5 px-8 py-2.5 bg-red-600 text-white text-sm font-bold rounded-xl hover:bg-red-700 transition-all shadow-sm shadow-red-200 cursor-pointer hover-scale active:scale-95">
                                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                                    Aceptar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
