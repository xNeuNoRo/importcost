@model IEnumerable<ImportCostPro.Application.ViewModels.ExchageRateViewModels.ExchangeRateViewModel>
@{
    ViewData["Title"] = "Tasas de Cambio";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate__animated animate__fadeIn">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Tasas de Cambio</h1>
        <p class="text-sm text-gray-500">Gestione los valores de conversión entre divisas extranjeras y la moneda local.</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center justify-center gap-2.5 px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-all shadow-sm shadow-blue-200 cursor-pointer hover-scale btn-fancy">
        <i data-lucide="plus" class="w-5 h-5"></i>
        Nueva Tasa
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3 text-green-700 shadow-sm animate__animated animate__fadeInDown">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-red-700 shadow-sm animate__animated animate__shakeX">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["ErrorMessage"]</p>
    </div>
}

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden animate__animated animate__fadeInUp animate__faster">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50/50 border-b border-gray-200">
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Conversión</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Valor Tasa</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Fecha Vigencia</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Estado</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-gray-500 italic">
                            No se han registrado tasas de cambio todavía.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50/50 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="flex flex-col">
                                    <span class="text-sm font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                                        @item.FromCurrencyIsoCode <i data-lucide="arrow-right" class="inline w-3 h-3 mx-1 text-gray-400"></i> @item.ToCurrencyIsoCode
                                    </span>
                                    <span class="text-[10px] text-gray-400 uppercase font-medium">@item.FromCurrencyName</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="text-sm font-mono font-bold text-gray-700 bg-gray-50 px-2 py-1 rounded border border-gray-100">
                                @item.RateValue.ToString("N4")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center gap-1.5 text-sm text-gray-600">
                                <i data-lucide="calendar" class="w-3.5 h-3.5 text-gray-400"></i>
                                @item.EffectiveDate.ToString("dd/MM/yyyy")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            @{
                                var badgeClass = item.DisplayStatus switch
                                {
                                    "Vigente" => "bg-emerald-100 text-emerald-700 border-emerald-200",
                                    "Programada" => "bg-blue-100 text-blue-700 border-blue-200",
                                    "Expirada" => "bg-amber-50 text-amber-600 border-amber-100",
                                    "Inactivo" => "bg-rose-100 text-rose-700 border-rose-200",
                                    _ => "bg-gray-100 text-gray-700 border-gray-200"
                                };

                                var icon = item.DisplayStatus switch
                                {
                                    "Vigente" => "check-circle-2",
                                    "Programada" => "clock",
                                    "Expirada" => "history",
                                    "Inactivo" => "x-circle",
                                    _ => "alert-circle"
                                };
                            }
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] uppercase tracking-wider font-bold border shadow-sm @badgeClass">
                                <i data-lucide="@icon" class="w-3.5 h-3.5"></i>
                                @item.DisplayStatus
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-2">
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="inline">
                                    <button type="submit" class="p-2.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all cursor-pointer hover-scale" title="@(item.IsActive ? "Desactivar" : "Activar")">
                                        <i data-lucide="@(item.IsActive ? "toggle-right" : "toggle-left")" class="w-5 h-5"></i>
                                    </button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="p-2.5 text-gray-400 hover:text-amber-600 hover:bg-amber-50 rounded-xl transition-all cursor-pointer hover-scale" title="Editar">
                                    <i data-lucide="edit-3" class="w-5 h-5"></i>
                                </a>
                                <button type="button" onclick="confirmDelete(@item.Id, '@item.FromCurrencyIsoCode a @item.ToCurrencyIsoCode')" class="p-2.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer hover-scale" title="Eliminar">
                                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, conversion) {
            Swal.fire({
                title: '¿Eliminar tasa?',
                text: `¿Está seguro que desea eliminar la tasa para "${conversion}"? Esta acción no se puede deshacer si ya fue utilizada.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold ml-2',
                    cancelButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '@Url.Action("Delete")';
                    
                    const idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'id';
                    idInput.value = id;
                    
                    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiForgeryToken) {
                        form.appendChild(antiForgeryToken.cloneNode());
                    }
                    
                    form.appendChild(idInput);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}
