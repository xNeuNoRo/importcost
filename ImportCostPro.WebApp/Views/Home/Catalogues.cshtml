@{
    ViewData["Title"] = "Gestión de Catálogos";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Catálogos", null, null)
    };
}

<div class="animate__animated animate__fadeIn">
    <div class="mb-10">
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">Centro de <span class="text-blue-600">Catálogos</span></h1>
        <p class="text-gray-500 mt-2 text-lg">Administre los datos maestros que alimentan el motor de liquidación.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @* Card: Productos *@
        <a asp-controller="Product" asp-action="Index" class="group bg-white border border-gray-200 rounded-3xl p-6 hover:border-blue-500 hover:shadow-xl hover:shadow-blue-100 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-blue-50 rounded-full blur-2xl group-hover:bg-blue-100 transition-colors"></div>
            <div class="relative z-10">
                <div class="p-3 bg-blue-50 text-blue-600 rounded-2xl w-fit mb-4 group-hover:bg-blue-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="box" class="w-6 h-6"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">Catálogo de Productos</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Gestión de artículos, pesos, dimensiones y unidades de medida.</p>
            </div>
        </a>

        @* Card: Importadores *@
        <a asp-controller="Importer" asp-action="Index" class="group bg-white border border-gray-200 rounded-3xl p-6 hover:border-indigo-500 hover:shadow-xl hover:shadow-indigo-100 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-indigo-50 rounded-full blur-2xl group-hover:bg-indigo-100 transition-colors"></div>
            <div class="relative z-10">
                <div class="p-3 bg-indigo-50 text-indigo-600 rounded-2xl w-fit mb-4 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="users" class="w-6 h-6"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">Importadores</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Registro de empresas o personas que realizan las compras.</p>
            </div>
        </a>

        @* Card: Proveedores *@
        <a asp-controller="Supplier" asp-action="Index" class="group bg-white border border-gray-200 rounded-3xl p-6 hover:border-emerald-500 hover:shadow-xl hover:shadow-emerald-100 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-emerald-50 rounded-full blur-2xl group-hover:bg-emerald-100 transition-colors"></div>
            <div class="relative z-10">
                <div class="p-3 bg-emerald-50 text-emerald-600 rounded-2xl w-fit mb-4 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="truck" class="w-6 h-6"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">Proveedores Externos</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Gestión de vendedores internacionales y sus monedas de origen.</p>
            </div>
        </a>

        @* Card: Países *@
        <a asp-controller="Country" asp-action="Index" class="group bg-white border border-gray-200 rounded-3xl p-6 hover:border-amber-500 hover:shadow-xl hover:shadow-amber-100 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-amber-50 rounded-full blur-2xl group-hover:bg-amber-100 transition-colors"></div>
            <div class="relative z-10">
                <div class="p-3 bg-amber-50 text-amber-600 rounded-2xl w-fit mb-4 group-hover:bg-amber-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="globe" class="w-6 h-6"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">Países Registrados</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Listado de naciones habilitadas para orígenes de importación.</p>
            </div>
        </a>

        @* Card: Monedas *@
        <a asp-controller="Currency" asp-action="Index" class="group bg-white border border-gray-200 rounded-3xl p-6 hover:border-purple-500 hover:shadow-xl hover:shadow-purple-100 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-purple-50 rounded-full blur-2xl group-hover:bg-purple-100 transition-colors"></div>
            <div class="relative z-10">
                <div class="p-3 bg-purple-50 text-purple-600 rounded-2xl w-fit mb-4 group-hover:bg-purple-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="coins" class="w-6 h-6"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">Divisas y Monedas</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Configuración de monedas internacionales y moneda local base.</p>
            </div>
        </a>

        @* Card: Tasas *@
        <a asp-controller="ExchangeRate" asp-action="Index" class="group bg-white border border-gray-200 rounded-3xl p-6 hover:border-rose-500 hover:shadow-xl hover:shadow-rose-100 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-rose-50 rounded-full blur-2xl group-hover:bg-rose-100 transition-colors"></div>
            <div class="relative z-10">
                <div class="p-3 bg-rose-50 text-rose-600 rounded-2xl w-fit mb-4 group-hover:bg-rose-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="trending-up" class="w-6 h-6"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">Tasas de Cambio</h3>
                <p class="text-sm text-gray-500 leading-relaxed">Historial de conversiones necesarias para el cálculo de costos.</p>
            </div>
        </a>

        @* Card: Categorías *@
        <a asp-controller="TariffCategory" asp-action="Index" class="group bg-white border border-gray-200 rounded-3xl p-6 hover:border-cyan-500 hover:shadow-xl hover:shadow-cyan-100 transition-all duration-300 relative overflow-hidden lg:col-span-3">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-cyan-50 rounded-full blur-2xl group-hover:bg-cyan-100 transition-colors"></div>
            <div class="relative z-10 flex flex-col md:flex-row md:items-center gap-6">
                <div class="p-3 bg-cyan-50 text-cyan-600 rounded-2xl w-fit group-hover:bg-cyan-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="book-open" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-1">Categorías Arancelarias</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Clasificación fiscal, porcentajes de aranceles e impuestos selectivos aplicables.</p>
                </div>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
