@{
    ViewData["Title"] = "Créditos del Proyecto";
}

<div class="animate__animated animate__fadeIn">
    @* Encabezado de Página *@
    <div class="text-center mb-16">
        <div class="inline-flex p-3 bg-blue-50 text-blue-600 rounded-2xl mb-4 shadow-sm">
            <i data-lucide="award" class="w-8 h-8"></i>
        </div>
        <h1 class="text-4xl font-black text-gray-900 tracking-tight mb-4">The <span class="text-blue-600">Dream
            Team</span>
        </h1>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
            Este sistema ha sido desarrollado como una solución integral para la gestión logística de importaciones,
            fruto del esfuerzo conjunto y la excelencia técnica del equipo de ingeniería.
        </p>
        <span class="inline-block px-4 py-2 mt-4 bg-blue-100 text-blue-600 rounded-full text-sm font-bold">
            Profe, por el respeto debe ponernos 10/10.
        </span>
    </div>

    @* Rejilla de Desarrolladores *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">

        @* Isaias - Dev *@
        <div
            class="bg-white border-2 border-emerald-100 rounded-[2.5rem] p-8 text-center relative overflow-hidden group hover:border-emerald-500 transition-all hover:shadow-2xl hover:shadow-emerald-100">
            <div
                class="absolute top-0 right-0 -mr-6 -mt-6 w-24 h-24 bg-emerald-500/5 rounded-full blur-2xl group-hover:bg-emerald-500/10 transition-colors">
            </div>

            <div class="relative z-10">
                <div
                    class="w-24 h-24 bg-linear-to-tr from-emerald-500 to-teal-600 rounded-3xl mx-auto flex items-center justify-center text-white text-3xl font-black shadow-lg shadow-emerald-200 mb-6 group-hover:scale-110 transition-transform">
                    IF
                </div>
                <h2 class="text-xl font-black text-gray-900 mb-1">Isaias Jose Morillo F.</h2>
                <p class="text-emerald-600 font-bold text-xs uppercase tracking-widest mb-4">Software Developer</p>
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-mono rounded-full border border-emerald-100 mb-8">
                    Matrícula: 2025-1242
                </div>

                <a href="https://github.com/IsaiasMorillo" target="_blank"
                   class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-emerald-600 text-white rounded-2xl font-bold text-sm hover:bg-emerald-700 transition-all hover-scale shadow-lg shadow-emerald-200">
                    <i data-lucide="github" class="w-5 h-5"></i>
                    Ver perfil en GitHub
                </a>
            </div>
        </div>

        @* Angel - Lead Dev *@
        <div
            class="bg-white border-2 border-blue-100 rounded-[2.5rem] p-8 text-center relative overflow-hidden group hover:border-blue-500 transition-all hover:shadow-2xl hover:shadow-blue-100">
            <div
                class="absolute top-0 right-0 -mr-6 -mt-6 w-24 h-24 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-colors">
            </div>

            <div class="relative z-10">
                <div
                    class="w-24 h-24 bg-linear-to-tr from-blue-600 to-indigo-600 rounded-3xl mx-auto flex items-center justify-center text-white text-3xl font-black shadow-lg shadow-blue-200 mb-6 group-hover:scale-110 transition-transform">
                    AM
                </div>
                <h2 class="text-xl font-black text-gray-900 mb-1">Angel Gonzalez Muñoz</h2>
                <p class="text-blue-600 font-bold text-xs uppercase tracking-widest mb-4">Líder de Desarrollo</p>
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 text-blue-600 text-[10px] font-mono rounded-full border border-blue-100 mb-8">
                    Matrícula: 2025-1122
                </div>

                <a href="https://github.com/xNeuNoRo" target="_blank"
                   class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-gray-900 text-white rounded-2xl font-bold text-sm hover:bg-black transition-all hover-scale shadow-lg shadow-gray-200">
                    <i data-lucide="github" class="w-5 h-5"></i>
                    Ver perfil en GitHub
                </a>
            </div>
        </div>

        @* Engel - Dev *@
        <div
            class="bg-white border-2 border-indigo-100 rounded-[2.5rem] p-8 text-center relative overflow-hidden group hover:border-indigo-500 transition-all hover:shadow-2xl hover:shadow-indigo-100">
            <div
                class="absolute top-0 right-0 -mr-6 -mt-6 w-24 h-24 bg-indigo-500/5 rounded-full blur-2xl group-hover:bg-indigo-500/10 transition-colors">
            </div>

            <div class="relative z-10">
                <div
                    class="w-24 h-24 bg-linear-to-tr from-indigo-500 to-purple-600 rounded-3xl mx-auto flex items-center justify-center text-white text-3xl font-black shadow-lg shadow-indigo-200 mb-6 group-hover:scale-110 transition-transform">
                    AS
                </div>
                <h2 class="text-xl font-black text-gray-900 mb-1">Engel Orlando Acosta D.</h2>
                <p class="text-indigo-600 font-bold text-xs uppercase tracking-widest mb-4">Software Developer</p>
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 text-indigo-600 text-[10px] font-mono rounded-full border border-indigo-100 mb-8">
                    Matrícula: 2025-0037
                </div>

                <a href="https://github.com/notengel" target="_blank"
                   class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-indigo-600 text-white rounded-2xl font-bold text-sm hover:bg-indigo-700 transition-all hover-scale shadow-lg shadow-indigo-200">
                    <i data-lucide="github" class="w-5 h-5"></i>
                    Ver perfil en GitHub
                </a>
            </div>
        </div>
    </div>

    @* Sello Institucional *@
    <div class="border-t border-gray-200 pt-12 text-center pb-12">
        <div class="flex items-center justify-center gap-4 text-gray-400 font-bold uppercase tracking-[0.4em] text-xs">
            <span>ITLA</span>
            <span class="w-2 h-2 bg-blue-600 rounded-full"></span>
            <span>Desarrollo de Software</span>
            <span class="w-2 h-2 bg-blue-600 rounded-full"></span>
            <span>2026</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
