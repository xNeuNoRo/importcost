@model ImportCostPro.Application.ViewModels.DashboardViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Panel Principal de Control";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Dashboard", null, null)
    };
}

<div class="animate__animated animate__fadeIn">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">Bienvenido a ImportCost <span
            class="text-blue-600">Pro</span></h1>
            <p class="text-gray-500 mt-2 text-lg">Supervisión en tiempo real de sus importaciones y liquidaciones
                logísticas.</p>
            </div>

            @* KPIs Dinámicos *@
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
                @* Órdenes Abiertas *@
                <div
                    class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
                    <div class="flex items-center justify-between mb-4">
                        <div
                            class="p-3 bg-blue-50 text-blue-600 rounded-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i data-lucide="package-search" class="w-6 h-6"></i>
                        </div>
                        <span class="flex items-center gap-1 text-xs font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded-full">
                            Activas
                        </span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-2xl font-black text-gray-900">@Model.OpenOrdersCount</span>
                        <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Órdenes Abiertas</span>
                    </div>
                </div>

                @* Proveedores *@
                <div
                    class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
                    <div class="flex items-center justify-between mb-4">
                        <div
                            class="p-3 bg-indigo-50 text-indigo-600 rounded-2xl group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                            <i data-lucide="truck" class="w-6 h-6"></i>
                        </div>
                        <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">
                            Sincronizado
                        </span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-2xl font-black text-gray-900">@Model.ActiveSuppliersCount</span>
                        <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Proveedores
                            Externos</span>
                        </div>
                    </div>

                    @* Inversión Mensual *@
                    <div
                        class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
                        <div class="flex items-center justify-between mb-4">
                            <div
                                class="p-3 bg-amber-50 text-amber-600 rounded-2xl group-hover:bg-amber-600 group-hover:text-white transition-colors">
                                <i data-lucide="calculator" class="w-6 h-6"></i>
                            </div>
                            <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-1 rounded-full">
                                Este Mes
                            </span>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-2xl font-black text-gray-900">@Model.CurrencySymbol
                                @Model.MonthlyLiquidatedTotal.ToString("N1")M</span>
                                <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Inversión
                                    Liquidada</span>
                                </div>
                            </div>

                            @* Tasas Pendientes *@
                            <div
                                class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
                                <div class="flex items-center justify-between mb-4">
                                    <div
                                        class="p-3 bg-rose-50 text-rose-600 rounded-2xl group-hover:bg-rose-600 group-hover:text-white transition-colors">
                                        <i data-lucide="alert-circle" class="w-6 h-6"></i>
                                    </div>
                                    @if (Model.PendingExchangeRatesCount > 0)
                                    {
                                        <span class="text-xs font-bold text-rose-600 bg-rose-50 px-2 py-1 rounded-full animate-pulse">
                                            Acción Requerida
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">
                                            Al Día
                                        </span>
                                    }
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-2xl font-black text-gray-900">@Model.PendingExchangeRatesCount</span>
                                    <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Tasas por
                                        Actualizar</span>
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
                                @* Acciones Principales *@
                                <div class="lg:col-span-2 space-y-6">
                                    <div
                                        class="bg-linear-to-br from-blue-600 to-indigo-700 rounded-3xl p-8 text-white shadow-xl shadow-blue-100 relative overflow-hidden group">
                                        <div
                                            class="absolute top-0 right-0 p-12 opacity-10 transform translate-x-12 -translate-y-12 transition-transform group-hover:scale-110">
                                            <i data-lucide="anchor" class="w-64 h-64"></i>
                                        </div>
                                        <div class="relative z-10">
                                            <h2 class="text-2xl font-bold mb-4">¿Desea liquidar una nueva importación?</h2>
                                            <p class="text-blue-100 mb-8 max-w-md">Registre su orden de compra y el sistema automatizará el
                                                cálculo del costo real puesto en sus almacenes.</p>
                                                <a asp-controller="ImportOrder" asp-action="Create"
                                                   class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-700 font-bold rounded-xl hover:bg-blue-50 transition-all hover-scale shadow-lg">
                                                    <i data-lucide="plus" class="w-5 h-5"></i>
                                                    Nueva Orden de Importación
                                                </a>
                                            </div>
                                        </div>

                                        @* Detalle de Tasas Pendientes *@
                                        @if (Model.MissingCurrencies.Any())
                                        {
                                            <div
                                                class="bg-white border border-rose-100 rounded-3xl shadow-sm overflow-hidden animate__animated animate__fadeInUp">
                                                <div class="px-6 py-4 bg-rose-50 border-b border-rose-100 flex items-center justify-between">
                                                    <div class="flex items-center gap-3">
                                                        <div class="p-2 bg-rose-600 text-white rounded-lg shadow-sm shadow-rose-200">
                                                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
                                                        </div>
                                                        <h3 class="text-sm font-bold text-rose-900 uppercase tracking-widest">Tasas de Cambio Faltantes
                                                            (Hoy)</h3>
                                                        </div>
                                                        <span class="text-xs font-bold text-rose-600">Requiere Sincronización</span>
                                                    </div>
                                                    <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                        @foreach (var currency in Model.MissingCurrencies)
                                                        {
                                                            <div
                                                                class="flex items-center justify-between p-4 rounded-2xl bg-gray-50 border border-gray-100 group hover:border-rose-200 transition-all">
                                                                <div class="flex items-center gap-4">
                                                                    <div
                                                                        class="p-2.5 bg-white border border-gray-200 text-gray-700 font-black rounded-xl shadow-xs group-hover:bg-rose-600 group-hover:text-white group-hover:border-rose-600 transition-all">
                                                                        @currency.IsoCode
                                                                    </div>
                                                                    <div>
                                                                        <span class="block text-sm font-bold text-gray-900">@currency.Name</span>
                                                                        <span class="text-[10px] text-gray-400 uppercase font-bold tracking-tighter">Moneda
                                                                            Pendiente</span>
                                                                        </div>
                                                                    </div>
                                                                    <a asp-controller="ExchangeRate" asp-action="Create" asp-route-fromCurrencyId="@currency.Id"
                                                                       class="p-2 text-rose-600 hover:bg-rose-600 hover:text-white rounded-xl transition-all shadow-sm"
                                                                       title="Registrar Tasa Ahora">
                                                                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                                                                    </a>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            @* Feedback y Estado *@
                                            <div class="space-y-6">
                                                <div class="bg-white border border-gray-200 rounded-3xl shadow-sm p-6">
                                                    <h3 class="text-sm font-bold text-gray-900 mb-6 flex items-center gap-2">
                                                        <i data-lucide="shield-check" class="w-4 h-4 text-blue-600"></i>
                                                        Garantía de Integridad
                                                    </h3>
                                                    <div class="space-y-6">
                                                        <div class="flex gap-4">
                                                            <div class="w-1 h-12 bg-emerald-500 rounded-full"></div>
                                                            <div>
                                                                <span
                                                                class="block text-xs font-bold text-gray-400 uppercase tracking-widest">Disponibilidad</span>
                                                                <span class="text-sm font-semibold text-gray-700">Plataforma Lista</span>
                                                                <span class="block text-[10px] text-gray-400 mt-1">Sincronización de datos activa.</span>
                                                            </div>
                                                        </div>
                                                        <div class="flex gap-4">
                                                            <div class="w-1 h-12 bg-blue-500 rounded-full"></div>
                                                            <div>
                                                                <span class="block text-xs font-bold text-gray-400 uppercase tracking-widest">Validación
                                                                    Fiscal</span>
                                                                    <span class="text-sm font-semibold text-gray-700">Reglas Actualizadas</span>
                                                                    <span class="block text-[10px] text-gray-400 mt-1">Cálculos alineados a normativa
                                                                        aduanal.</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="bg-indigo-900 rounded-3xl p-6 text-white shadow-xl shadow-indigo-100">
                                                            <div class="flex items-center gap-3 mb-4">
                                                                <div class="p-2 bg-white/10 rounded-xl">
                                                                    <i data-lucide="sparkles" class="w-5 h-5 text-indigo-300"></i>
                                                                </div>
                                                                <span class="text-xs font-bold uppercase tracking-widest text-indigo-200">Confianza en sus
                                                                    Números</span>
                                                                </div>
                                                                <p class="text-sm text-indigo-100 leading-relaxed">Nuestro motor asegura que cada centavo sea
                                                                    prorrateado con exactitud absoluta, facilitando su toma de decisiones financieras.</p>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        @* Accesos Rápidos Inferiores Configurables *@
                                                        <div
                                                            class="bg-white border border-gray-200 rounded-3xl shadow-sm overflow-hidden animate__animated animate__fadeInUp">
                                                            <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                                                                <h3 class="text-sm font-black text-gray-900 uppercase tracking-widest">Accesos Rápidos Personalizados</h3>
                                                                <button onclick="configureQuickAccess()"
                                                                        class="p-2 text-gray-400 hover:text-blue-600 hover:bg-white rounded-xl transition-all cursor-pointer hover-scale shadow-sm"
                                                                        title="Configurar Accesos Rápidos">
                                                                    <i data-lucide="settings" class="w-5 h-5"></i>
                                                                </button>
                                                            </div>
                                                            <div id="quick-access-container" class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                                                @* Los elementos se cargan dinámicamente vía JS *@
                                                            </div>
                                                            <div id="no-tools-message" class="hidden p-12 text-center">
                                                                <div class="p-4 bg-gray-50 rounded-2xl inline-block mb-4 text-gray-400">
                                                                    <i data-lucide="layout-grid" class="w-8 h-8"></i>
                                                                </div>
                                                                <p class="text-sm font-medium text-gray-500">No ha seleccionado ninguna herramienta para acceso rápido.</p>
                                                                <button onclick="configureQuickAccess()"
                                                                        class="mt-4 text-blue-600 font-bold text-xs uppercase tracking-widest hover:underline">Configurar
                                                                    ahora</button>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        @section Scripts {
                                                            <script>
                                                                lucide.createIcons();

                                                                const ALL_TOOLS = [
                                                                    { id: 'currencies', label: 'Divisas', desc: 'Manejo de monedas base', icon: 'coins', color: 'blue', url: '@Url.Action("Index", "Currency")' },
                                                                    { id: 'taxes', label: 'Impuestos', desc: 'Tasas de ITBIS y Aduanas', icon: 'percent', color: 'purple', url: '@Url.Action("Index", "TaxConfiguration")' },
                                                                    { id: 'countries', label: 'Países', desc: 'Orígenes de importación', icon: 'globe', color: 'emerald', url: '@Url.Action("Index", "Country")' },
                                                                    { id: 'products', label: 'Productos', desc: 'Catálogo de artículos', icon: 'box', color: 'amber', url: '@Url.Action("Index", "Product")' },
                                                                    { id: 'importers', label: 'Importadores', desc: 'Registro de empresas', icon: 'building', color: 'indigo', url: '@Url.Action("Index", "Importer")' },
                                                                    { id: 'suppliers', label: 'Proveedores', desc: 'Vendedores externos', icon: 'truck', color: 'rose', url: '@Url.Action("Index", "Supplier")' },
                                                                    { id: 'rates', label: 'Tasas de Cambio', desc: 'Historial de divisas', icon: 'trending-up', color: 'cyan', url: '@Url.Action("Index", "ExchangeRate")' },
                                                                    { id: 'categories', label: 'Categorías', desc: 'Clasificación fiscal', icon: 'book-open', color: 'orange', url: '@Url.Action("Index", "TariffCategory")' }
                                                                ];

                                                                function renderQuickAccess() {
                                                                    const saved = JSON.parse(localStorage.getItem('dashboard-quick-access') || '["currencies", "taxes", "rates", "products"]');
                                                                    const container = document.getElementById('quick-access-container');
                                                                    const emptyMsg = document.getElementById('no-tools-message');

                                                                    container.innerHTML = '';
                                                                    const selectedTools = ALL_TOOLS.filter(t => saved.includes(t.id));

                                                                    if (selectedTools.length === 0) {
                                                                        container.classList.add('hidden');
                                                                        emptyMsg.classList.remove('hidden');
                                                                    } else {
                                                                        container.classList.remove('hidden');
                                                                        emptyMsg.classList.add('hidden');

                                                                        selectedTools.forEach(tool => {
                                                                            const card = `
                                                                                                                                                                                                                                                                                                                                                                                        <a href="${tool.url}" class="flex items-center gap-4 p-4 rounded-2xl bg-white hover:bg-${tool.color}-50 border border-gray-100 hover:border-${tool.color}-200 transition-all group hover-scale shadow-sm">
                                                                                                                                                                                                                                                                                                                                                                                            <div class="p-2 bg-${tool.color}-50 text-${tool.color}-600 rounded-xl group-hover:bg-${tool.color}-600 group-hover:text-white transition-all duration-300">
                                                                                                                                                                                                                                                                                                                                                                                                <i data-lucide="${tool.icon}" class="w-5 h-5"></i>
                                                                                                                                                                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                                                                                                                                                                            <div class="min-w-0">
                                                                                                                                                                                                                                                                                                                                                                                                <span class="block text-sm font-black text-gray-900 truncate">${tool.label}</span>
                                                                                                                                                                                                                                                                                                                                                                                                <span class="block text-[10px] text-gray-400 truncate uppercase font-bold tracking-tighter">${tool.desc}</span>
                                                                                                                                                                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                                                                                                                                                                        </a>
                                                                                                                                                                                                                                                                                                                                                                                    `;
                                                                            container.innerHTML += card;
                                                                        });
                                                                        lucide.createIcons();
                                                                    }
                                                                }

                                                                function configureQuickAccess() {
                                                                    const saved = JSON.parse(localStorage.getItem('dashboard-quick-access') || '["currencies", "taxes", "rates", "products"]');

                                                                    let html = '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 p-4">';
                                                                    ALL_TOOLS.forEach(tool => {
                                                                        const isChecked = saved.includes(tool.id);
                                                                        html += `
                                                                                                                                                                                                                                                                                                                                                                                    <div onclick="toggleToolSelection('${tool.id}')" 
                                                                                                                                                                                                                                                                                                                                                                                         id="tool-card-${tool.id}"
                                                                                                                                                                                                                                                                                                                                                                                         class="cursor-pointer p-4 rounded-2xl border-2 transition-all duration-300 flex flex-col items-center text-center gap-2 group ${isChecked ? 'border-blue-600 bg-blue-50 shadow-md' : 'border-gray-100 bg-gray-50 hover:border-blue-200'}">
                                                                                                                                                                                                                                                                                                                                                                                        <input type="checkbox" id="check-${tool.id}" class="hidden" ${isChecked ? 'checked' : ''}>
                                                                                                                                                                                                                                                                                                                                                                                        <div class="p-3 rounded-xl ${isChecked ? 'bg-blue-600 text-white' : 'bg-white text-gray-400 group-hover:text-blue-500'} shadow-sm transition-all duration-300">
                                                                                                                                                                                                                                                                                                                                                                                            <i data-lucide="${tool.icon}" class="w-6 h-6"></i>
                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                        <div>
                                                                                                                                                                                                                                                                                                                                                                                            <p class="text-xs font-black text-gray-900 leading-tight">${tool.label}</p>
                                                                                                                                                                                                                                                                                                                                                                                            <p class="text-[9px] text-gray-400 font-bold uppercase mt-1">Configurar</p>
                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                `;
                                                                    });
                                                                    html += '</div>';

                                                                    Swal.fire({
                                                                        title: 'Personalizar Accesos',
                                                                        html: html,
                                                                        width: '800px',
                                                                        showCancelButton: true,
                                                                        confirmButtonColor: '#2563eb',
                                                                        cancelButtonColor: '#6b7280',
                                                                        confirmButtonText: 'Actualizar Panel',
                                                                        cancelButtonText: 'Cancelar',
                                                                        didOpen: () => {
                                                                            lucide.createIcons();
                                                                        },
                                                                        customClass: {
                                                                            popup: 'rounded-[2.5rem]',
                                                                            confirmButton: 'rounded-xl px-8 py-3 text-sm font-bold',
                                                                            cancelButton: 'rounded-xl px-8 py-3 text-sm font-bold'
                                                                        },
                                                                        preConfirm: () => {
                                                                            const selected = Array.from(document.querySelectorAll('.swal2-html-container input:checked')).map(el => el.id.replace('check-', ''));
                                                                            localStorage.setItem('dashboard-quick-access', JSON.stringify(selected));
                                                                            return selected;
                                                                        }
                                                                    }).then((result) => {
                                                                        if (result.isConfirmed) {
                                                                            renderQuickAccess();
                                                                            Swal.fire({
                                                                                icon: 'success',
                                                                                title: 'Panel actualizado',
                                                                                toast: true,
                                                                                position: 'top-end',
                                                                                showConfirmButton: false,
                                                                                timer: 2000
                                                                            });
                                                                        }
                                                                    });
                                                                }

                                                                function toggleToolSelection(id) {
                                                                    const card = document.getElementById(`tool-card-${id}`);
                                                                    const checkbox = document.getElementById(`check-${id}`);
                                                                    const iconContainer = card.querySelector('div:nth-child(2)');

                                                                    checkbox.checked = !checkbox.checked;

                                                                    if (checkbox.checked) {
                                                                        card.classList.remove('border-gray-100', 'bg-gray-50');
                                                                        card.classList.add('border-blue-600', 'bg-blue-50', 'shadow-md');
                                                                        iconContainer.classList.remove('bg-white', 'text-gray-400');
                                                                        iconContainer.classList.add('bg-blue-600', 'text-white');
                                                                    } else {
                                                                        card.classList.add('border-gray-100', 'bg-gray-50');
                                                                        card.classList.remove('border-blue-600', 'bg-blue-50', 'shadow-md');
                                                                        iconContainer.classList.add('bg-white', 'text-gray-400');
                                                                        iconContainer.classList.remove('bg-blue-600', 'text-white');
                                                                    }
                                                                }

                                                                // Inicializar al cargar
                                                                renderQuickAccess();
                                                            </script>
                                                        }
