@model ImportCostPro.Application.ViewModels.DashboardViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Panel Principal de Control";
}

<div class="animate__animated animate__fadeIn">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">Bienvenido a ImportCost <span class="text-blue-600">Pro</span></h1>
        <p class="text-gray-500 mt-2 text-lg">Supervisión en tiempo real de sus importaciones y liquidaciones logísticas.</p>
    </div>

    @* KPIs Dinámicos *@
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        @* Órdenes Abiertas *@
        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
            <div class="flex items-center justify-between mb-4">
                <div class="p-3 bg-blue-50 text-blue-600 rounded-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <i data-lucide="package-search" class="w-6 h-6"></i>
                </div>
                <span class="flex items-center gap-1 text-xs font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded-full">
                    Activas
                </span>
            </div>
            <div class="flex flex-col">
                <span class="text-2xl font-black text-gray-900">@Model.OpenOrdersCount</span>
                <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Órdenes Abiertas</span>
            </div>
        </div>

        @* Proveedores *@
        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
            <div class="flex items-center justify-between mb-4">
                <div class="p-3 bg-indigo-50 text-indigo-600 rounded-2xl group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                    <i data-lucide="truck" class="w-6 h-6"></i>
                </div>
                <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">
                    Sincronizado
                </span>
            </div>
            <div class="flex flex-col">
                <span class="text-2xl font-black text-gray-900">@Model.ActiveSuppliersCount</span>
                <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Proveedores Externos</span>
            </div>
        </div>

        @* Inversión Mensual *@
        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
            <div class="flex items-center justify-between mb-4">
                <div class="p-3 bg-amber-50 text-amber-600 rounded-2xl group-hover:bg-amber-600 group-hover:text-white transition-colors">
                    <i data-lucide="calculator" class="w-6 h-6"></i>
                </div>
                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-1 rounded-full">
                    Este Mes
                </span>
            </div>
            <div class="flex flex-col">
                <span class="text-2xl font-black text-gray-900">@Model.CurrencySymbol @Model.MonthlyLandedCostTotal.ToString("N1")M</span>
                <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Inversión Liquidada</span>
            </div>
        </div>

        @* Tasas Pendientes *@
        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition-all group cursor-default">
            <div class="flex items-center justify-between mb-4">
                <div class="p-3 bg-rose-50 text-rose-600 rounded-2xl group-hover:bg-rose-600 group-hover:text-white transition-colors">
                    <i data-lucide="alert-circle" class="w-6 h-6"></i>
                </div>
                @if (Model.PendingExchangeRatesCount > 0)
                {
                    <span class="text-xs font-bold text-rose-600 bg-rose-50 px-2 py-1 rounded-full animate-pulse">
                        Acción Requerida
                    </span>
                }
                else
                {
                    <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">
                        Al Día
                    </span>
                }
            </div>
            <div class="flex flex-col">
                <span class="text-2xl font-black text-gray-900">@Model.PendingExchangeRatesCount</span>
                <span class="text-sm font-medium text-gray-400 uppercase tracking-widest mt-1">Tasas por Actualizar</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        @* Acciones Principales *@
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl p-8 text-white shadow-xl shadow-blue-100 relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-12 opacity-10 transform translate-x-12 -translate-y-12 transition-transform group-hover:scale-110">
                    <i data-lucide="anchor" class="w-64 h-64"></i>
                </div>
                <div class="relative z-10">
                    <h2 class="text-2xl font-bold mb-4">¿Desea liquidar una nueva importación?</h2>
                    <p class="text-blue-100 mb-8 max-w-md">Registre su orden de compra y el sistema automatizará el cálculo del costo real puesto en sus almacenes.</p>
                    <a asp-controller="ImportOrder" asp-action="Create" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-700 font-bold rounded-xl hover:bg-blue-50 transition-all hover-scale shadow-lg">
                        <i data-lucide="plus" class="w-5 h-5"></i>
                        Nueva Orden de Importación
                    </a>
                </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-3xl shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest">Configuraciones de Soporte</h3>
                    <i data-lucide="settings" class="w-4 h-4 text-gray-400"></i>
                </div>
                <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <a asp-controller="Currency" asp-action="Index" class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 border border-transparent hover:border-gray-100 transition-all">
                        <div class="p-2 bg-blue-50 text-blue-600 rounded-xl">
                            <i data-lucide="coins" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <span class="block text-sm font-bold text-gray-900">Divisas</span>
                            <span class="text-xs text-gray-400">Manejo de monedas base</span>
                        </div>
                    </a>
                    <a asp-controller="TaxConfiguration" asp-action="Index" class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 border border-transparent hover:border-gray-100 transition-all">
                        <div class="p-2 bg-purple-50 text-purple-600 rounded-xl">
                            <i data-lucide="percent" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <span class="block text-sm font-bold text-gray-900">Impuestos Globales</span>
                            <span class="text-xs text-gray-400">Tasas de ITBIS y Aduanas</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        @* Feedback y Estado Orientado al Usuario *@
        <div class="space-y-6">
            <div class="bg-white border border-gray-200 rounded-3xl shadow-sm p-6">
                <h3 class="text-sm font-bold text-gray-900 mb-6 flex items-center gap-2">
                    <i data-lucide="shield-check" class="w-4 h-4 text-blue-600"></i>
                    Garantía de Integridad
                </h3>
                <div class="space-y-6">
                    <div class="flex gap-4">
                        <div class="w-1 h-12 bg-emerald-500 rounded-full"></div>
                        <div>
                            <span class="block text-xs font-bold text-gray-400 uppercase tracking-widest">Disponibilidad</span>
                            <span class="text-sm font-semibold text-gray-700">Plataforma Lista</span>
                            <span class="block text-[10px] text-gray-400 mt-1">Sincronización de datos activa.</span>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="w-1 h-12 bg-blue-500 rounded-full"></div>
                        <div>
                            <span class="block text-xs font-bold text-gray-400 uppercase tracking-widest">Validación Fiscal</span>
                            <span class="text-sm font-semibold text-gray-700">Reglas Actualizadas</span>
                            <span class="block text-[10px] text-gray-400 mt-1">Cálculos alineados a normativa aduanal.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-indigo-900 rounded-3xl p-6 text-white shadow-xl shadow-indigo-100">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-2 bg-white/10 rounded-xl">
                        <i data-lucide="sparkles" class="w-5 h-5 text-indigo-300"></i>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-indigo-200">Confianza en sus Números</span>
                </div>
                <p class="text-sm text-indigo-100 leading-relaxed">Nuestro motor asegura que cada centavo sea prorrateado con exactitud absoluta, facilitando su toma de decisiones financieras.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
