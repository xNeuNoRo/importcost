@model ImportCostPro.Application.ViewModels.ImportExpenseViewModels.CreateImportExpenseViewModel
@using ImportCostPro.Persistence.Enums
@{
    ViewData["Title"] = "Registrar Gasto de Importación";
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-action="Manage" asp-route-orderId="@Model.ImportOrderId" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver a gastos
    </a>
    <h1 class="text-2xl font-bold text-gray-900 mt-2">Nuevo Gasto</h1>
    <p class="text-sm text-gray-500">Registre un costo adicional para la orden @ViewBag.OrderNumber.</p>
</div>

<div class="max-w-4xl animate__animated animate__fadeInUp animate__faster">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-300">
        <form asp-action="Add" method="post" class="p-6 sm:p-8">
            <input type="hidden" asp-for="ImportOrderId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm animate__animated animate__shakeX">
                </div>
            }

            <div class="space-y-8">
                @* Sección: Clasificación del Gasto *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i data-lucide="tag" class="w-5 h-5 text-blue-600"></i>
                        Clasificación y Descripción
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group md:col-span-2">
                            <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"></label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="type" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Description" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="Ej: Flete marítimo China-Haina" />
                            </div>
                            <span asp-validation-for="Description" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="ExpenseType" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Tipo de Gasto</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="list" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="ExpenseType" asp-items="Html.GetEnumSelectList<ExpenseType>()" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none cursor-pointer">
                                    <option value="">Seleccione tipo...</option>
                                </select>
                            </div>
                            <span asp-validation-for="ExpenseType" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="DistributionBase" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Método de Prorrateo</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="pie-chart" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="DistributionBase" asp-items="Html.GetEnumSelectList<DistributionBase>()" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none cursor-pointer">
                                    <option value="">Seleccione método...</option>
                                </select>
                            </div>
                            <span asp-validation-for="DistributionBase" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>
                </div>

                @* Sección: Valores Monetarios *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i data-lucide="banknote" class="w-5 h-5 text-blue-600"></i>
                        Importe y Moneda
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="group">
                            <label asp-for="OriginalAmount" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Monto del Gasto</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="dollar-sign" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="OriginalAmount" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none font-mono" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="OriginalAmount" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="CurrencyId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Divisa</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="coins" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="CurrencyId" asp-items="ViewBag.Currencies" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none cursor-pointer">
                                    <option value="">Seleccione moneda...</option>
                                </select>
                            </div>
                            <span asp-validation-for="CurrencyId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="ExpenseDate" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Fecha de Factura</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="calendar" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="ExpenseDate" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" />
                            </div>
                            <span asp-validation-for="ExpenseDate" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-10 pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Manage" asp-route-orderId="@Model.ImportOrderId" class="px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition-all cursor-pointer">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex items-center justify-center gap-2.5 px-8 py-2.5 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-200 transition-all cursor-pointer hover-scale active:scale-95">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Registrar Gasto
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
