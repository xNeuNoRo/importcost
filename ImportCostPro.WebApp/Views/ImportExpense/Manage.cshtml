@model IEnumerable<ImportCostPro.Application.ViewModels.ImportExpenseViewModels.ImportExpenseViewModel>
@using ImportCostPro.Persistence.Enums
@using ImportCostPro.Application.ViewModels.ImportOrderViewModels
@{
    var order = (ImportOrderViewModel)ViewBag.Order;
    bool isLocked = order.Status != OrderStatus.Open;
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-controller="ImportOrder" asp-action="Edit" asp-route-id="@order.Id" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver a la orden
    </a>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-2">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Gastos de la Orden @order.OrderNumber</h1>
            <p class="text-sm text-gray-500">Registre y distribuya los costos adicionales para el cálculo del CIF y la liquidación de costos.</p>
        </div>
        @if (!isLocked)
        {
            <a asp-action="Add" asp-route-orderId="@order.Id" class="inline-flex items-center justify-center gap-2.5 px-6 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-all shadow-sm shadow-indigo-200 cursor-pointer hover-scale btn-fancy">
                <i data-lucide="receipt" class="w-5 h-5"></i>
                Registrar Gasto
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3 text-green-700 shadow-sm animate__animated animate__fadeInDown">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-red-700 shadow-sm animate__animated animate__shakeX">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["ErrorMessage"]</p>
    </div>
}

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden animate__animated animate__fadeInUp animate__faster">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50/50 border-b border-gray-200">
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Gasto / Descripción</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Monto</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Moneda</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Base de Prorrateo</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Fecha</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500 italic">
                            No se han registrado gastos para esta orden todavía.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50/50 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex flex-col">
                                <span class="text-sm font-bold text-gray-900 group-hover:text-indigo-600 transition-colors">@item.ExpenseType.GetDisplayName()</span>
                                <span class="text-xs text-gray-500 italic">@item.Description</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <span class="text-sm font-mono font-bold text-gray-700">@item.OriginalAmount.ToString("N2")</span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-100 uppercase">
                                @item.CurrencyIsoCode
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="text-xs text-gray-600 font-medium">@item.DistributionBase.GetDisplayName()</span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="text-xs text-gray-500">@item.ExpenseDate.ToString("dd/MM/yyyy")</span>
                        </td>
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-2">
                                @if (!isLocked)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-2.5 text-gray-400 hover:text-amber-600 hover:bg-amber-50 rounded-xl transition-all cursor-pointer hover-scale" title="Editar Gasto">
                                        <i data-lucide="edit-3" class="w-5 h-5"></i>
                                    </a>
                                    <button type="button" onclick="confirmDelete(@item.Id, '@item.ExpenseType.GetDisplayName()')" class="p-2.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer hover-scale" title="Eliminar Gasto">
                                        <i data-lucide="trash-2" class="w-5 h-5"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="p-2.5 text-gray-300" title="Orden bloqueada">
                                        <i data-lucide="lock" class="w-5 h-5"></i>
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, type) {
            Swal.fire({
                title: 'Eliminar Gasto',
                text: '¿Está seguro que desea eliminar este gasto de importación?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Aceptar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold ml-2',
                    cancelButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '@Url.Action("Delete")';
                    
                    const idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'id';
                    idInput.value = id;
                    
                    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiForgeryToken) {
                        form.appendChild(antiForgeryToken.cloneNode());
                    }
                    
                    form.appendChild(idInput);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}
