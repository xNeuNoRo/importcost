@model ImportCostPro.Application.ViewModels.ImportOrderViewModels.UpdateImportOrderViewModel
@using ImportCostPro.Persistence.Enums
@{
    ViewData["Title"] = "Editar Orden";
    bool isLocked = Model.Status == OrderStatus.Closed || Model.Status == OrderStatus.Canceled;
    bool isCalculated = Model.Status == OrderStatus.Calculated;
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver atrás
    </a>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-2">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Orden de Compra #@Model.OrderNumber</h1>
            <div class="flex items-center gap-2 mt-1">
                @{
                    var statusClass = Model.Status switch
                    {
                        OrderStatus.Open => "bg-blue-50 text-blue-700 border-blue-100",
                        OrderStatus.Calculated => "bg-amber-50 text-amber-700 border-amber-100",
                        OrderStatus.Closed => "bg-emerald-50 text-emerald-700 border-emerald-100",
                        OrderStatus.Canceled => "bg-gray-100 text-gray-600 border-gray-200",
                        _ => "bg-gray-50 text-gray-500"
                    };
                }
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border uppercase tracking-wider @statusClass">
                    @Model.Status.GetDisplayName()
                </span>
                <span class="text-xs text-gray-400">•</span>
                <span class="text-xs text-gray-500 font-medium">Registrada el @Model.OrderDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        @if (Model.Status == OrderStatus.Calculated)
        {
            <button type="button" onclick="confirmClose(@Model.Id)" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-emerald-600 text-white text-sm font-bold rounded-xl hover:bg-emerald-700 transition-all shadow-sm shadow-emerald-200 cursor-pointer hover-scale">
                <i data-lucide="lock" class="w-4 h-4"></i>
                Cerrar orden
            </button>

            <form id="closeOrderForm_@Model.Id" asp-action="ChangeStatus" method="post" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="newStatus" value="@OrderStatus.Closed" />
            </form>
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    @* Columna Izquierda: Formulario de Datos Base *@
    <div class="lg:col-span-2 space-y-8">
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden animate__animated animate__fadeInUp animate__faster">
            <div class="bg-gray-50/50 px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-blue-600 rounded-lg text-white">
                        <i data-lucide="file-edit" class="w-4 h-4"></i>
                    </div>
                    <h3 class="text-sm font-bold text-gray-900">Datos Generales</h3>
                </div>
            </div>

            <form asp-action="Edit" method="post" class="p-6 sm:p-8">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Status" />

                @* Centro de Alertas Unificado *@
                @if (TempData["ErrorMessage"] != null || !ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex flex-col gap-2 text-red-700 shadow-sm animate__animated animate__shakeX">
                        <div class="flex items-center gap-3">
                            <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                            <p class="text-sm font-bold">Han ocurrido los siguientes inconvenientes:</p>
                        </div>
                        <div class="ml-8 text-xs space-y-1">
                            @if (TempData["ErrorMessage"] != null)
                            {
                                <p>@TempData["ErrorMessage"]</p>
                            }
                            <div asp-validation-summary="All" class="validation-summary-fancy"></div>
                        </div>
                    </div>
                }

                <div class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="group">
                            <label asp-for="OrderNumber" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Número de orden</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="hash" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="OrderNumber" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none uppercase @(isLocked ? "bg-gray-100 cursor-not-allowed" : "")" readonly="@isLocked" />
                            </div>
                            <span asp-validation-for="OrderNumber" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="OrderDate" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Fecha de la orden</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="calendar" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="OrderDate" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none @(isLocked || isCalculated ? "bg-gray-100 cursor-not-allowed" : "")" readonly="@(isLocked || isCalculated)" />
                            </div>
                            <span asp-validation-for="OrderDate" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="TransportMode" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Modalidad de transporte</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="ship" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="TransportMode" asp-items="Html.GetEnumSelectList<TransportMode>()" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none @(isLocked || isCalculated ? "bg-gray-100 cursor-not-allowed" : "cursor-pointer")" disabled="@(isLocked || isCalculated)"></select>
                                @if (isLocked || isCalculated) { <input type="hidden" asp-for="TransportMode" /> }
                            </div>
                            <span asp-validation-for="TransportMode" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group">
                            <label asp-for="ImporterId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Importador</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="building" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="ImporterId" asp-items="ViewBag.Importers" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none @(isLocked || isCalculated ? "bg-gray-100 cursor-not-allowed" : "cursor-pointer")" disabled="@(isLocked || isCalculated)"></select>
                            </div>
                            @if (isLocked || isCalculated) { <input type="hidden" asp-for="ImporterId" /> }
                            <span asp-validation-for="ImporterId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="SupplierId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Proveedor</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="truck" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none @(isLocked || isCalculated ? "bg-gray-100 cursor-not-allowed" : "cursor-pointer")" disabled="@(isLocked || isCalculated)"></select>
                            </div>
                            @if (isLocked || isCalculated) { <input type="hidden" asp-for="SupplierId" /> }
                            <span asp-validation-for="SupplierId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="OriginCountryId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">País de origen</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="globe" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="OriginCountryId" asp-items="ViewBag.Countries" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none @(isLocked || isCalculated ? "bg-gray-100 cursor-not-allowed" : "cursor-pointer")" disabled="@(isLocked || isCalculated)"></select>
                            </div>
                            @if (isLocked || isCalculated) { <input type="hidden" asp-for="OriginCountryId" /> }
                            <span asp-validation-for="OriginCountryId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="CurrencyId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Moneda</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="coins" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="CurrencyId" asp-items="ViewBag.Currencies" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none @(isLocked || isCalculated ? "bg-gray-100 cursor-not-allowed" : "cursor-pointer")" disabled="@(isLocked || isCalculated)"></select>
                            </div>
                            @if (isLocked || isCalculated) { <input type="hidden" asp-for="CurrencyId" /> }
                            <span asp-validation-for="CurrencyId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>

                    @if (isCalculated)
                    {
                        <p class="text-[11px] text-amber-600 bg-amber-50 p-3 rounded-xl border border-amber-100 flex items-center gap-2">
                            <i data-lucide="info" class="w-4 h-4"></i>
                            No se pueden modificar estos datos porque la orden ya tiene una Liquidación de Costos oficial.
                        </p>
                    }

                    @if (!isLocked)
                    {
                        <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-end">
                            <button type="submit" class="inline-flex items-center justify-center gap-2 px-8 py-2.5 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 transition-all cursor-pointer hover-scale active:scale-95">
                                <i data-lucide="save" class="w-4 h-4"></i>
                                Guardar cambios
                            </button>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>

    @* Columna Derecha: Acciones Rápidas *@
    <div class="space-y-6">
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 animate__animated animate__fadeInRight animate__faster">
            <h3 class="text-sm font-bold text-gray-900 mb-4 flex items-center gap-2 uppercase tracking-widest text-[10px]">
                <i data-lucide="zap" class="w-4 h-4 text-amber-500"></i>
                Gestión de la Orden
            </h3>
            <div class="grid grid-cols-1 gap-3">
                <a asp-controller="OrderProduct" asp-action="Manage" asp-route-orderId="@Model.Id" asp-route-source="Edit"
                   class="flex items-center justify-between px-4 py-3 bg-gray-50 hover:bg-blue-50 text-gray-700 hover:text-blue-700 rounded-xl border border-gray-200 hover:border-blue-200 transition-all group">
                    <div class="flex items-center gap-3">
                        <i data-lucide="package" class="w-5 h-5 text-gray-400 group-hover:text-blue-500"></i>
                        <span class="text-sm font-semibold">Productos</span>
                    </div>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"></i>
                </a>

                <a asp-controller="ImportExpense" asp-action="Manage" asp-route-orderId="@Model.Id" asp-route-source="Edit" 
                   class="flex items-center justify-between px-4 py-3 bg-gray-50 hover:bg-indigo-50 text-gray-700 hover:text-indigo-700 rounded-xl border border-gray-200 hover:border-indigo-200 transition-all group">
                    <div class="flex items-center gap-3">
                        <i data-lucide="receipt" class="w-5 h-5 text-gray-400 group-hover:text-indigo-500"></i>
                        <span class="text-sm font-semibold">Gastos</span>
                    </div>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"></i>
                </a>

                @if (isCalculated || Model.Status == OrderStatus.Closed)
                {
                    <a asp-controller="LandedCost" asp-action="Details" asp-route-orderId="@Model.Id" 
                       class="flex items-center justify-between px-4 py-3 bg-blue-600 text-white rounded-xl border border-blue-700 transition-all group hover:bg-blue-700 shadow-md shadow-blue-100">
                        <div class="flex items-center gap-3">
                            <i data-lucide="file-text" class="w-5 h-5 text-blue-200 group-hover:text-white"></i>
                            <span class="text-sm font-bold">Ver Liquidación</span>
                        </div>
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </a>
                }
            </div>
        </div>

        @if (!isLocked)
        {
            <div class="bg-rose-50/50 border border-rose-100 rounded-2xl p-6">
                <h3 class="text-xs font-bold text-rose-800 uppercase tracking-wider mb-4">Acción Especial</h3>
                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" asp-route-newStatus="@OrderStatus.Canceled" method="post">
                    <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white text-rose-600 text-xs font-bold rounded-xl border border-rose-200 hover:bg-rose-600 hover:text-white transition-all cursor-pointer">
                        <i data-lucide="ban" class="w-4 h-4"></i>
                        Anular Orden
                    </button>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmClose(id) {
            Swal.fire({
                title: 'Cerrar orden de importación',
                text: '¿Está seguro que desea cerrar esta orden de importación? Una vez cerrada, no podrá modificar sus datos, productos, gastos ni resultado de cálculo.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Aceptar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold ml-2',
                    cancelButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('closeOrderForm_' + id).submit();
                }
            });
        }
    </script>
}
