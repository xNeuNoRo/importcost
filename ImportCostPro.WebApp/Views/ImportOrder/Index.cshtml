@model IEnumerable<ImportCostPro.Application.ViewModels.ImportOrderViewModels.ImportOrderViewModel>
@using ImportCostPro.Persistence.Enums
@{
    ViewData["Title"] = "Registro de Órdenes";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate__animated animate__fadeIn">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Órdenes de Importación</h1>
        <p class="text-sm text-gray-500">Gestione el flujo de importación desde el registro hasta la liquidación de
            costos.</p>
        </div>
        <a asp-action="Create"
           class="inline-flex items-center justify-center gap-2.5 px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-all shadow-sm shadow-blue-200 cursor-pointer hover-scale btn-fancy">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Crear orden de importación
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div
            class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3 text-green-700 shadow-sm animate__animated animate__fadeInDown">
            <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
            <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div
            class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-red-700 shadow-sm animate__animated animate__shakeX">
            <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
            <p class="text-sm font-medium">@TempData["ErrorMessage"]</p>
        </div>
    }

    <div
        class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden animate__animated animate__fadeInUp animate__faster">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/50 border-b border-gray-200">
                        <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Orden</th>
                        <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Importador /
                            Proveedor</th>
                            <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">
                                Estado</th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">
                                    Totales (FOB / Liquidado)</th>
                                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">
                                        Acciones</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    @if (!Model.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="px-6 py-12 text-center text-gray-500 italic">
                                                No se encontraron órdenes registradas en el sistema.
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr class="hover:bg-gray-50/50 transition-colors group">
                                            <td class="px-6 py-4">
                                                <div class="flex flex-col">
                                                    <span
                                                    class="text-sm font-bold text-gray-900 group-hover:text-blue-600 transition-colors">@item.OrderNumber</span>
                                                    <span class="text-[11px] text-gray-500 flex items-center gap-1 mt-0.5">
                                                        <i data-lucide="calendar" class="w-3 h-3"></i>
                                                        @item.OrderDate.ToString("dd/MM/yyyy")
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="flex flex-col gap-0.5">
                                                    <span class="text-sm font-medium text-gray-700">@item.ImporterName</span>
                                                    <span class="text-xs text-gray-400 flex items-center gap-1">
                                                        <i data-lucide="truck" class="w-3 h-3"></i>
                                                        @item.SupplierName
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                @{
                                                    var statusClass = item.Status switch
                                                    {
                                                        OrderStatus.Open => "bg-blue-50 text-blue-700 border-blue-100",
                                                        OrderStatus.Calculated => "bg-amber-50 text-amber-700 border-amber-100",
                                                        OrderStatus.Closed => "bg-emerald-50 text-emerald-700 border-emerald-100",
                                                        OrderStatus.Canceled => "bg-gray-100 text-gray-600 border-gray-200",
                                                        _ => "bg-gray-50 text-gray-500"
                                                    };
                                                }
                                                <span
                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border uppercase tracking-wider @statusClass">
                                                    @item.Status.GetDisplayName()
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right">
                                                <div class="flex flex-col">
                                                    <span class="text-sm font-mono font-bold text-gray-700">@item.FobTotal.ToString("C2")</span>
                                                    @if (item.TotalLandedCost > 0 && (item.Status == OrderStatus.Calculated || item.Status == OrderStatus.Closed))
                                                    {
                                                        <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-tighter">Liquidado: @item.TotalLandedCost.ToString("C2")</span>
                                                    }
                                                    else if (item.Status == OrderStatus.Canceled)
                                                    {
                                                        <span class="text-[10px] text-red-400 uppercase font-bold tracking-tighter">Anulada</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[10px] text-gray-400 uppercase tracking-tighter">Pendiente</span>
                                                    }
                                                </div>
                                            </td>

                                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                                    <div class="flex items-center justify-end gap-1.5">
                                                        <a asp-action="Details" asp-route-id="@item.Id"
                                                           class="p-2 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all cursor-pointer hover-scale"
                                                           title="Ver detalle">
                                                            <i data-lucide="eye" class="w-5 h-5"></i>
                                                        </a>

                                                        @if (item.Status == OrderStatus.Open || item.Status == OrderStatus.Calculated)
                                                        {
                                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                                               class="p-2 text-gray-400 hover:text-amber-600 hover:bg-amber-50 rounded-xl transition-all cursor-pointer hover-scale"
                                                               title="Editar">
                                                                <i data-lucide="edit-3" class="w-5 h-5"></i>
                                                            </a>
                                                        }

                                                        @if (item.Status == OrderStatus.Open)
                                                        {
                                                            <form asp-controller="LandedCost" asp-action="Calculate" asp-route-orderId="@item.Id"
                                                                  method="post" class="inline">
                                                                <button type="submit"
                                                                        class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition-all cursor-pointer hover-scale"
                                                                        title="Calcular">
                                                                    <i data-lucide="calculator" class="w-5 h-5"></i>
                                                                </button>
                                                            </form>
                                                            <button type="button" onclick="confirmDelete(@item.Id, '@item.OrderNumber')"
                                                                    class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer hover-scale"
                                                                    title="Eliminar">
                                                                <i data-lucide="trash-2" class="w-5 h-5"></i>
                                                            </button>
                                                        }
                                                        else if (item.Status == OrderStatus.Calculated)
                                                        {
                                                            <button type="button" onclick="alertLockedDeletion()"
                                                                    class="p-2 text-gray-200 cursor-not-allowed"
                                                                    title="No se puede eliminar una orden liquidada">
                                                                <i data-lucide="trash-2" class="w-5 h-5"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @section Scripts {
                            <script>
                                function confirmDelete(id, number) {
                                    Swal.fire({
                                        title: 'Eliminar Orden',
                                        text: '¿Está seguro que desea eliminar esta orden de importación?',
                                        icon: 'warning',
                                        showCancelButton: true,
                                        confirmButtonColor: '#ef4444',
                                        cancelButtonColor: '#6b7280',
                                        confirmButtonText: 'Aceptar',
                                        cancelButtonText: 'Cancelar',
                                        reverseButtons: true,
                                        customClass: {
                                            confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold ml-2',
                                            cancelButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                                        }
                                    }).then((result) => {
                                        if (result.isConfirmed) {
                                            const form = document.createElement('form');
                                            form.method = 'POST';
                                            form.action = '@Url.Action("Delete")';

                                            const idInput = document.createElement('input');
                                            idInput.type = 'hidden';
                                            idInput.name = 'id';
                                            idInput.value = id;

                                            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                                            if (antiForgeryToken) {
                                                form.appendChild(antiForgeryToken.cloneNode());
                                            }

                                            form.appendChild(idInput);
                                            document.body.appendChild(form);
                                            form.submit();
                                        }
                                    });
                                }

                                function alertLockedDeletion() {
                                    Swal.fire({
                                        title: 'Operación no permitida',
                                        text: 'No se puede eliminar esta orden porque ya tiene una Liquidación de Costos oficial.',
                                        icon: 'error',
                                        confirmButtonColor: '#3b82f6',
                                        confirmButtonText: 'Entendido',
                                        customClass: {
                                            confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                                        }
                                    });
                                }
                            </script>
                        }
