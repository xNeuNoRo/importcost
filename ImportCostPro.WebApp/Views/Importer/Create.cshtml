@model ImportCostPro.Application.ViewModels.Importer.ImporterCreateViewModel
@{
    ViewData["Title"] = "Nuevo Importador";
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver al listado
    </a>
    <h1 class="text-2xl font-bold text-gray-900 mt-2">Registrar Nuevo Importador</h1>
    <p class="text-sm text-gray-500">Configure la información legal y de contacto para un nuevo importador.</p>
</div>

<div class="max-w-4xl animate__animated animate__fadeInUp animate__faster">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-300">
        <form asp-action="Create" method="post" class="p-6 sm:p-8">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm animate__animated animate__shakeX">
                </div>
            }

            <div class="space-y-8">
                @* Sección: Datos Legales *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-5 h-5 text-blue-600"></i>
                        Información Legal
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group md:col-span-2">
                            <label asp-for="LegalName" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Nombre o Razón Social</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="building-2" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="LegalName" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="Ej: Importadora del Caribe S.A.S" />
                            </div>
                            <span asp-validation-for="LegalName" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="TaxId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">RNC / Identificación Fiscal</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="file-digit" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="TaxId" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none uppercase" placeholder="Ej: 1-01-00000-1" />
                            </div>
                            <span asp-validation-for="TaxId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="CountryId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">País de Origen</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="globe" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="CountryId" asp-items="ViewBag.Countries" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none cursor-pointer">
                                    <option value="">Seleccione un país...</option>
                                </select>
                            </div>
                            <span asp-validation-for="CountryId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>
                </div>

                @* Sección: Contacto *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i data-lucide="contact-2" class="w-5 h-5 text-blue-600"></i>
                        Información de Contacto
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group">
                            <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Correo Electrónico</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="mail" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Email" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="ejemplo@correo.com" />
                            </div>
                            <span asp-validation-for="Email" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="PhoneNumber" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Teléfono</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="phone" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="PhoneNumber" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="Ej: 809-555-5555" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group md:col-span-2">
                            <label asp-for="Address" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Dirección Física</label>
                            <div class="relative">
                                <div class="absolute top-3 left-3.5 text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="map-pin" class="w-4 h-4"></i>
                                </div>
                                <textarea asp-for="Address" rows="2" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none resize-none" placeholder="Calle, número, sector..."></textarea>
                            </div>
                            <span asp-validation-for="Address" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-10 pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition-all cursor-pointer">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex items-center justify-center gap-2.5 px-8 py-2.5 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-200 transition-all cursor-pointer hover-scale active:scale-95">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Guardar Importador
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
