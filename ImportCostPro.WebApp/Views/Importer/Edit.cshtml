@model ImportCostPro.Application.ViewModels.Importer.ImporterUpdateViewModel

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver al listado
    </a>
    <h1 class="mt-2 text-2xl font-bold text-gray-900">Editar Importador</h1>
    <p class="text-sm text-gray-500">Actualiza los datos del importador seleccionado.</p>
</div>

<div class="max-w-3xl overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    <form asp-action="Edit" method="post" class="p-6 sm:p-8">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>
        <input type="hidden" asp-for="Id" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label asp-for="LegalName" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                <input asp-for="LegalName" class="block w-full rounded-lg border-gray-300 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all" />
                <span asp-validation-for="LegalName" class="text-xs text-red-600 mt-1"></span>
            </div>

            <div>
                <label asp-for="TaxId" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                <input asp-for="TaxId" class="block w-full rounded-lg border-gray-300 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all" />
                <span asp-validation-for="TaxId" class="text-xs text-red-600 mt-1"></span>
            </div>

            <div>
                <label asp-for="CountryId" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                <select asp-for="CountryId" asp-items="ViewBag.Countries" class="block w-full rounded-lg border-gray-300 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all">
                    <option value="">-- Seleccione un País --</option>
                </select>
                <span asp-validation-for="CountryId" class="text-xs text-red-600 mt-1"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                <input asp-for="Email" class="block w-full rounded-lg border-gray-300 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all" />
                <span asp-validation-for="Email" class="text-xs text-red-600 mt-1"></span>
            </div>

            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                <input asp-for="PhoneNumber" class="block w-full rounded-lg border-gray-300 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all" />
                <span asp-validation-for="PhoneNumber" class="text-xs text-red-600 mt-1"></span>
            </div>

            <div class="md:col-span-2">
                <label asp-for="Address" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                <textarea asp-for="Address" rows="3" class="block w-full rounded-lg border-gray-300 text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all"></textarea>
                <span asp-validation-for="Address" class="text-xs text-red-600 mt-1"></span>
            </div>

            <div class="flex items-center gap-3 py-2">
                <div class="flex h-5 items-center">
                    <input asp-for="IsActive" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 transition-all">
                </div>
                <div class="text-sm">
                    <label asp-for="IsActive" class="font-medium text-gray-700">Estado Activo</label>
                </div>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-6">
            <a asp-action="Index" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition-all">
                Cancelar
            </a>
            <button type="submit" class="rounded-lg bg-blue-600 px-6 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all">
                Actualizar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
