@model ImportCostPro.Application.ViewModels.LandedCostViewModels.LandedCostCalculationViewModel
@using ImportCostPro.Persistence.Enums
@{
    ViewData["Title"] = $"Resultado Liquidación - {Model.OrderNumber}";
    bool isClosed = Model.OrderStatus == OrderStatus.Closed;
}

<div class="mb-6 animate__animated animate__fadeIn">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <a asp-controller="ImportOrder" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Volver atrás
            </a>
            <h1 class="text-2xl font-bold text-gray-900 mt-2">Liquidación Oficial: Orden @Model.OrderNumber</h1>
            <p class="text-sm text-gray-500">Determinación del costo unitario puesto en almacén y desglose de gravámenes.</p>
        </div>
        <div class="flex items-center gap-3">
            @if (Model.OrderStatus == OrderStatus.Calculated)
            {
                <button type="button" onclick="confirmClose(@Model.ImportOrderId)" class="inline-flex items-center justify-center gap-2 px-5 py-2 bg-emerald-600 text-white text-sm font-bold rounded-xl hover:bg-emerald-700 transition-all cursor-pointer shadow-sm shadow-emerald-200 hover-scale active:scale-95">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                    Cerrar orden
                </button>
            }
            <button onclick="window.print()" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-white text-gray-700 text-sm font-semibold rounded-lg border border-gray-200 hover:bg-gray-50 transition-all cursor-pointer shadow-sm">
                <i data-lucide="printer" class="w-4 h-4"></i>
                Imprimir Reporte
            </button>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3 text-green-700 shadow-sm animate__animated animate__fadeInDown">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
    </div>
}

@* Panel de Resumen Superior *@
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 animate__animated animate__fadeInUp animate__faster">
    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Valor FOB Total (Local)</span>
            <div class="p-1.5 bg-blue-50 text-blue-600 rounded-lg">
                <i data-lucide="banknote" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex flex-col">
            <span class="text-xl font-black text-gray-900">@Model.TotalLocalFob.ToString("C2")</span>
            <span class="text-[10px] text-gray-400 mt-1 font-medium">Tasa aplicada: @Model.ExchangeRateUsed.ToString("N4") (@Model.LocalCurrencyIsoCode)</span>
        </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Valor CIF Total</span>
            <div class="p-1.5 bg-indigo-50 text-indigo-600 rounded-lg">
                <i data-lucide="ship" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex flex-col">
            <span class="text-xl font-black text-gray-900">@Model.TotalCif.ToString("C2")</span>
            <span class="text-[10px] text-gray-400 mt-1 font-medium">Incluye Flete y Seguro</span>
        </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Impuestos Pagados</span>
            <div class="p-1.5 bg-purple-50 text-purple-600 rounded-lg">
                <i data-lucide="calculator" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex flex-col">
            @{
                var totalTaxes = Model.TotalTariff + Model.TotalExciseTax + Model.TotalCustomsService + Model.TotalItbis;
            }
            <span class="text-xl font-black text-gray-900">@totalTaxes.ToString("C2")</span>
            <span class="text-[10px] text-gray-400 mt-1 font-medium">Arancel + ISC + Tasas + ITBIS</span>
        </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-blue-100 shadow-md shadow-blue-50">
        <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-blue-600 uppercase tracking-widest">Costo Puesto en Almacén</span>
            <div class="p-1.5 bg-blue-600 text-white rounded-lg">
                <i data-lucide="check-circle" class="w-4 h-4"></i>
            </div>
        </div>
        <div class="flex flex-col">
            <span class="text-xl font-black text-blue-700">@Model.TotalImportCost.ToString("C2")</span>
            <span class="text-[10px] text-blue-400 mt-1 font-bold">@Model.TotalImportedQuantity.ToString("N0") Unidades Totales</span>
        </div>
    </div>
</div>

@* Tabla Detallada *@
<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8 animate__animated animate__fadeInUp animate__delay-1s">
    <div class="bg-gray-50/50 px-6 py-4 border-b border-gray-200">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest">Desglose Analítico por Artículo</h3>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-350">
            <thead>
                <tr class="bg-gray-100/50 text-[10px] font-bold text-gray-500 uppercase tracking-wider">
                    <th class="px-4 py-3 border-b border-gray-200">Producto</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-center">Cant.</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">FOB Unit.</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">Flete Asig.</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">Seguro Asig.</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">Valor CIF</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">Arancel</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">Selectivo</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">Tasa Serv.</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">ITBIS</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right">Otros Gast.</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right bg-blue-50/30">Costo Unit.</th>
                    <th class="px-4 py-3 border-b border-gray-200 text-right bg-blue-50/30">P. Venta Sug.</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model.Details)
                {
                    <tr class="hover:bg-gray-50/50 transition-colors">
                        <td class="px-4 py-4">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-gray-900">@item.ProductName</span>
                                <span class="text-[9px] text-gray-400 font-mono">@item.ProductReferenceCode</span>
                            </div>
                        </td>
                        <td class="px-4 py-4 text-center">
                            <span class="text-xs font-semibold text-gray-600">@item.Quantity.ToString("N0")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-gray-500">@item.OriginalUnitPriceFob.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-gray-600">@item.AllocatedFreight.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-gray-600">@item.AllocatedInsurance.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono font-bold text-gray-700">@item.LocalTotalCif.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-rose-600">@item.CustomsDutyAmount.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-amber-600">@item.ExciseTaxAmount.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-gray-600">@item.CustomsServiceAmount.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-purple-600">@item.ItbisAmount.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right">
                            <span class="text-xs font-mono text-gray-500">@item.AllocatedLocalExpenses.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right bg-blue-50/20 font-bold">
                            <span class="text-xs font-mono font-black text-blue-700">@item.UnitLandedCost.ToString("N2")</span>
                        </td>
                        <td class="px-4 py-4 text-right bg-emerald-50/20 font-bold">
                            <span class="text-xs font-mono text-emerald-700">@item.SuggestedRetailPrice.ToString("N2")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Pie de Reporte Fiscal *@
<div class="max-w-xl ml-auto animate__animated animate__fadeInUp animate__delay-1s">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6">
        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Resumen Impositivo y Gastos</h4>
        <div class="space-y-3">
            <div class="flex justify-between items-center text-sm">
                <span class="text-gray-500">Total Gravámenes Arancelarios</span>
                <span class="font-mono font-bold text-rose-600">@Model.TotalTariff.ToString("C2")</span>
            </div>
            <div class="flex justify-between items-center text-sm">
                <span class="text-gray-500">Total Impuesto Selectivo (ISC)</span>
                <span class="font-mono font-bold text-amber-600">@Model.TotalExciseTax.ToString("C2")</span>
            </div>
            <div class="flex justify-between items-center text-sm">
                <span class="text-gray-500">Total Tasa Servicio de Aduanas</span>
                <span class="font-mono font-bold text-gray-700">@Model.TotalCustomsService.ToString("C2")</span>
            </div>
            <div class="flex justify-between items-center text-sm">
                <span class="text-gray-500">Total ITBIS Liquidado</span>
                <span class="font-mono font-bold text-purple-600">@Model.TotalItbis.ToString("C2")</span>
            </div>
            <div class="flex justify-between items-center text-sm">
                <span class="text-gray-500">Gastos Locales y Operativos</span>
                <span class="font-mono font-bold text-gray-900">@Model.TotalLocalExpenses.ToString("C2")</span>
            </div>
            <div class="mt-4 p-4 bg-blue-600 rounded-xl flex justify-between items-center text-white shadow-lg shadow-blue-100">
                <div class="flex flex-col">
                    <span class="text-[10px] font-bold uppercase tracking-wider opacity-80">Costo de Importación Consolidado</span>
                    <span class="text-xs opacity-80">Total Puesto en Almacén</span>
                </div>
                <span class="text-xl font-black">@Model.TotalImportCost.ToString("C2")</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        function confirmClose(id) {
            Swal.fire({
                title: 'Cerrar orden de importación',
                text: '¿Está seguro que desea cerrar esta orden de importación? Una vez cerrada, no podrá modificar sus datos, productos, gastos ni resultado de cálculo.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Aceptar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold ml-2',
                    cancelButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '@Url.Action("ChangeStatus", "ImportOrder")';
                    
                    const idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'id';
                    idInput.value = id;
                    
                    const statusInput = document.createElement('input');
                    statusInput.type = 'hidden';
                    statusInput.name = 'newStatus';
                    statusInput.value = '@OrderStatus.Closed';
                    
                    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiForgeryToken) {
                        form.appendChild(antiForgeryToken.cloneNode());
                    }
                    
                    form.appendChild(idInput);
                    form.appendChild(statusInput);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}

<style>
    @@media print {
        header, aside, .mb-6 a, .mb-6 button {
            display: none !important;
        }
        main {
            padding: 0 !important;
            background: white !important;
        }
        .rounded-2xl {
            border-radius: 0 !important;
            border: none !important;
            box-shadow: none !important;
        }
        .shadow-sm, .shadow-md, .shadow-lg {
            box-shadow: none !important;
        }
        .max-w-xl {
            max-width: 100% !important;
        }
    }
</style>
