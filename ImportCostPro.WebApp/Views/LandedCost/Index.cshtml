@{
    ViewData["Title"] = "Liquidación de Costos";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?)>
    {
        ("Operaciones", null, null),
        ("Liquidación", null, null)
    };
}

<div
    class="min-h-[80vh] flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8 animate__animated animate__fadeIn">
    @* Cabecera Centrada *@
    <div class="text-center mb-12 max-w-3xl">
        <h1 class="text-4xl font-black text-gray-900 tracking-tight sm:text-5xl mb-4">
            Liquidación de Costos de <span class="text-blue-600">Importación</span>
        </h1>
        <p class="text-lg text-gray-500 leading-relaxed">
            Nuestro motor de cálculo procesará automáticamente los gravámenes aduanales, prorrateará los gastos y
            determinará el costo real de su mercancía puesta en almacén.
        </p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div
            class="w-full max-w-4xl mb-8 p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center gap-3 text-red-700 shadow-sm animate__animated animate__shakeX">
            <i data-lucide="alert-circle" class="w-6 h-6 shrink-0"></i>
            <p class="text-sm font-semibold">@TempData["ErrorMessage"]</p>
        </div>
    }

    @* Card Principal Premium *@
    <div
        class="w-full max-w-5xl bg-white rounded-[2.5rem] shadow-2xl shadow-blue-100/50 border border-gray-100 overflow-hidden flex flex-col md:flex-row animate__animated animate__zoomIn animate__faster">

        @* Columna Izquierda: Info & Requisitos *@
        <div
            class="md:w-5/12 bg-linear-to-br from-blue-700 to-indigo-900 p-8 sm:p-12 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-48 h-48 bg-blue-400/10 rounded-full blur-2xl"></div>

            <div class="relative z-10 h-full flex flex-col">
                <div class="mb-8">
                    <div class="inline-flex p-3 bg-white/10 rounded-2xl backdrop-blur-md mb-6">
                        <i data-lucide="shield-check" class="w-8 h-8 text-blue-200"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-4">Garantía de Precisión</h2>
                    <p class="text-blue-100/80 text-sm leading-relaxed">
                        El sistema aplica la normativa vigente de la Dirección General de Aduanas (DGA) para el cálculo
                        de base imponible e impuestos.
                    </p>
                </div>

                <div class="mt-auto">
                    <h3 class="text-xs font-black uppercase tracking-widest text-blue-200 mb-4">Requisitos del Proceso
                    </h3>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <div class="mt-1 p-0.5 bg-emerald-400/20 rounded-full">
                                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400"></i>
                            </div>
                            <span class="text-xs text-blue-50">Productos con dimensiones y pesos oficiales.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="mt-1 p-0.5 bg-emerald-400/20 rounded-full">
                                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400"></i>
                            </div>
                            <span class="text-xs text-blue-50">Flete y Seguro Internacional registrados.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="mt-1 p-0.5 bg-emerald-400/20 rounded-full">
                                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400"></i>
                            </div>
                            <span class="text-xs text-blue-50">Tasas de cambio vigentes para divisas extranjeras.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        @* Columna Derecha: Formulario *@
        <div class="md:w-7/12 p-8 sm:p-12 flex flex-col justify-center">
            <form asp-action="Calculate" method="post" class="space-y-8">
                <div class="group">
                    <label for="orderId"
                           class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-3 group-focus-within:text-blue-600 transition-colors">Selección
                        de Orden Pendiente</label>
                        <div class="relative">
                            <div
                                class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                <i data-lucide="package-search" class="w-5 h-5"></i>
                            </div>
                            <select id="orderId" name="orderId" asp-items="ViewBag.Orders"
                                    class="block w-full pl-12 pr-4 py-4 bg-gray-50 border border-gray-200 rounded-2xl text-base font-medium focus:bg-white focus:ring-8 focus:ring-blue-500/5 focus:border-blue-500 transition-all outline-none cursor-pointer appearance-none shadow-sm">
                                <option value="">Seleccione una orden para liquidar...</option>
                            </select>
                            <div
                                class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-gray-400">
                                <i data-lucide="chevron-down" class="w-5 h-5"></i>
                            </div>
                        </div>
                        <p class="mt-3 text-xs text-gray-400">Solo se muestran órdenes en estado <span
                            class="font-bold text-blue-600">Abierta</span>.</p>
                        </div>

                        <div class="pt-4">
                            <button type="submit"
                                    class="w-full inline-flex items-center justify-center gap-3 px-8 py-4 bg-blue-600 text-white text-lg font-bold rounded-2xl hover:bg-blue-700 hover:shadow-2xl hover:shadow-blue-200 transition-all cursor-pointer hover-scale active:scale-95 btn-fancy">
                                <i data-lucide="calculator" class="w-6 h-6"></i>
                                Calcular Liquidación de Costos
                            </button>
                            <p class="text-center mt-6 text-xs text-gray-400 flex items-center justify-center gap-2">
                                <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                                Esta acción generará un registro oficial de costos inmutable.
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                document.querySelector('form').addEventListener('submit', function (e) {
                    const select = document.getElementById('orderId');
                    if (!select.value) {
                        e.preventDefault();
                        Swal.fire({
                            title: 'Atención',
                            text: 'Debe seleccionar una orden de importación para continuar.',
                            icon: 'warning',
                            confirmButtonColor: '#3b82f6',
                            confirmButtonText: 'Entendido',
                            customClass: {
                                confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                            }
                        });
                        return;
                    }

                    const btn = this.querySelector('button[type="submit"]');
                    btn.disabled = true;
                    btn.innerHTML = '<i data-lucide="loader-2" class="w-6 h-6 animate-spin"></i> Procesando liquidación...';
                    lucide.createIcons();
                });
            </script>
        }

        <style>
            .btn-fancy {
                background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
                border: none;
            }

            .btn-fancy:hover {
                background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 100%);
            }
        </style>
