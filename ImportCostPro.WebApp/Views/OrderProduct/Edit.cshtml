@model ImportCostPro.Application.ViewModels.OrderProductViewModels.UpdateOrderProductViewModel
@{
    ViewData["Title"] = "Editar Producto de Orden";
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-action="Manage" asp-route-orderId="@ViewBag.OrderId" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver a productos
    </a>
    <h1 class="text-2xl font-bold text-gray-900 mt-2">Editar Línea de Producto</h1>
    <p class="text-sm text-gray-500">Modifique la negociación para @ViewBag.ProductName en la orden @ViewBag.OrderNumber.</p>
</div>

<div class="max-w-3xl animate__animated animate__fadeInUp animate__faster">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-300">
        <form asp-action="Edit" method="post" class="p-6 sm:p-8">
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm animate__animated animate__shakeX">
                </div>
            }

            <div class="space-y-8">
                @* Sección: Selección de Producto (Bloqueada) *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i data-lucide="box" class="w-5 h-5 text-blue-600"></i>
                        Producto Seleccionado
                    </h3>
                    <div class="group">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Producto</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                                <i data-lucide="lock" class="w-4 h-4"></i>
                            </div>
                            <input value="@ViewBag.ProductName" class="block w-full pl-10 pr-4 py-2.5 bg-gray-100 border border-gray-200 rounded-lg text-sm text-gray-500 cursor-not-allowed outline-none" readonly />
                        </div>
                        <p class="mt-2 text-[10px] text-amber-600 italic">No se permite cambiar el producto. Si desea otro artículo, debe eliminar esta línea y agregar uno nuevo.</p>
                    </div>
                </div>

                @* Sección: Datos de Negociación *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i data-lucide="edit-2" class="w-5 h-5 text-blue-600"></i>
                        Actualizar Negociación
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="group">
                            <label asp-for="Quantity" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"></label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="package-plus" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Quantity" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none font-mono" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Quantity" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="UnitFobPrice" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Precio FOB Unitario</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="banknote" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="UnitFobPrice" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none font-mono" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="UnitFobPrice" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="TargetProfitMargin" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Margen Objetivo (%)</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="TargetProfitMargin" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none font-mono" placeholder="0" />
                            </div>
                            <span asp-validation-for="TargetProfitMargin" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-10 pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Manage" asp-route-orderId="@ViewBag.OrderId" asp-route-source="@ViewBag.Source" class="px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition-all cursor-pointer">
                    Volver atrás
                </a>
                <button type="submit" class="inline-flex items-center justify-center gap-2.5 px-8 py-2.5 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-200 transition-all cursor-pointer hover-scale active:scale-95">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
