@model IEnumerable<ImportCostPro.Application.ViewModels.OrderProductViewModels.OrderProductViewModel>
@using ImportCostPro.Persistence.Enums
@using ImportCostPro.Application.ViewModels.ImportOrderViewModels
@{
    var order = (ImportOrderViewModel)ViewBag.Order;
    ViewData["Title"] = $"Productos - {order.OrderNumber}";
    ViewData["Breadcrumbs"] = new List<(string, string?, string?, object?)>
    {
        ("Operaciones", null, null, null), ("Órdenes", "Index", "ImportOrder", null),
        ($"Orden #{order.OrderNumber}", "Details", "ImportOrder", order.Id),
        ("Productos", null, null, null)
    };
    bool isLocked = order.Status != OrderStatus.Open;
    string source = ViewBag.Source ?? (isLocked ? "Details" : "Edit");
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-controller="ImportOrder" asp-action="@source" asp-route-id="@order.Id" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver atrás
    </a>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-2">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Productos de la Orden @order.OrderNumber</h1>
            <p class="text-sm text-gray-500">Gestione los artículos y sus especificaciones de carga para esta importación.</p>
        </div>
        @if (!isLocked)
        {
            <a asp-action="Add" asp-route-orderId="@order.Id" class="inline-flex items-center justify-center gap-2.5 px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-all shadow-sm shadow-blue-200 cursor-pointer hover-scale btn-fancy">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Agregar Producto
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3 text-green-700 shadow-sm animate__animated animate__fadeInDown">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-red-700 shadow-sm animate__animated animate__shakeX">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["ErrorMessage"]</p>
    </div>
}

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden animate__animated animate__fadeInUp animate__faster">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50/50 border-b border-gray-200">
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Producto / Ref.</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Cant.</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Peso/Vol (T)</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Precio FOB U.</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Valor FOB Total</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500 italic">
                            No se han añadido productos a esta orden todavía.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50/50 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex flex-col">
                                <span class="text-sm font-bold text-gray-900 group-hover:text-blue-600 transition-colors">@item.ProductName</span>
                                <span class="text-[10px] text-gray-400 font-mono mt-0.5">Ref: @item.ProductReferenceCode</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex flex-col items-center">
                                <span class="text-sm font-semibold text-gray-700">@item.Quantity.ToString("N2")</span>
                                <span class="text-[10px] text-gray-400 uppercase font-bold tracking-tighter">@item.UnitOfMeasure.GetDisplayName()</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex flex-col items-end">
                                <span class="text-xs text-gray-600 font-medium">@item.TotalWeight.ToString("N2") kg</span>
                                <span class="text-[10px] text-gray-400">@item.TotalVolume.ToString("N0") cm³</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <span class="text-sm font-mono text-gray-600">@item.UnitFobPrice.ToString("N2")</span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <span class="text-sm font-mono font-bold text-gray-900">@item.SubtotalFob.ToString("N2")</span>
                        </td>
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-2">
                                @if (!isLocked)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-source="@source" class="p-2.5 text-gray-400 hover:text-amber-600 hover:bg-amber-50 rounded-xl transition-all cursor-pointer hover-scale" title="Editar Línea">
                                        <i data-lucide="edit-3" class="w-5 h-5"></i>
                                    </a>
                                    <button type="button" onclick="confirmDelete(@item.Id, '@item.ProductName')" class="p-2.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer hover-scale" title="Remover de la Orden">
                                        <i data-lucide="trash-2" class="w-5 h-5"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="p-2.5 text-gray-300" title="Registro bloqueado">
                                        <i data-lucide="lock" class="w-5 h-5"></i>
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @* Resumen de Carga al pie de la tabla *@
    <div class="bg-gray-50 border-t border-gray-200 p-6 flex flex-wrap items-center justify-end gap-12">
        <div class="flex flex-col items-end">
            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Peso Bruto Total</span>
            <span class="text-sm font-bold text-gray-900">@Model.Sum(x => x.TotalWeight).ToString("N2") kg</span>
        </div>
        <div class="flex flex-col items-end">
            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Volumen Total</span>
            <span class="text-sm font-bold text-gray-900">@Model.Sum(x => x.TotalVolume).ToString("N0") cm³</span>
        </div>
        <div class="flex flex-col items-end border-l border-gray-200 pl-12">
            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Valor FOB Total de la Orden</span>
            <span class="text-xl font-black text-blue-600">@Model.Sum(x => x.SubtotalFob).ToString("C2")</span>
        </div>
    </div>
</div>

@* Formulario Oculto para Eliminación de Productos de la Orden *@
<form id="deleteProductForm" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteProductId" />
    <input type="hidden" name="source" value="@source" />
</form>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: 'Eliminar Producto',
                text: '¿Está seguro que desea eliminar este producto?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Aceptar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold ml-2',
                    cancelButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteProductId').value = id;
                    document.getElementById('deleteProductForm').submit();
                }
            });
        }
    </script>
}
