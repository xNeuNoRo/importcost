@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorTitle</h4>
                </div>
                <div class="card-body text-center p-5">
                    <h1 class="display-1 text-muted mb-4">@Model.StatusCode</h1>
                    <h5 class="text-danger mb-4">@Model.ErrorMessage</h5>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-light border text-start mt-4" role="alert">
                            <strong>Identificador de Soporte (Request ID):</strong>
                            <code>@Model.RequestId</code>
                            <br />
                            <small class="text-muted">Proporcione este código al administrador del sistema si el problema
                                persiste.</small>
                            </div>
                        }

                        <div class="mt-5">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-house-door me-1"></i> Volver al Inicio
                            </a>
                            <button onclick="history.back()" class="btn btn-primary ms-2">
                                <i class="bi bi-arrow-left me-1"></i> Regresar a la página anterior
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>