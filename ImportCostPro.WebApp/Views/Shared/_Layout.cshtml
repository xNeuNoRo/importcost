<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ImportCost Pro</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .page-entry {
            animation: fadeIn 0.4s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hover-scale {
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .hover-scale:hover {
            transform: scale(1.05);
        }

        .btn-fancy {
            position: relative;
            overflow: hidden;
        }

        .btn-fancy::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 5px;
            height: 5px;
            background: rgba(255, 255, 255, .5);
            opacity: 0;
            border-radius: 100%;
            transform: scale(1, 1) translate(-50%);
            transform-origin: 50% 50%;
        }

        .btn-fancy:focus:not(:active)::after {
            animation: ripple 1s ease-out;
        }

        @@keyframes ripple {
            0% {
                transform: scale(0, 0);
                opacity: 0.5;
            }

            20% {
                transform: scale(25, 25);
                opacity: 0.3;
            }

            100% {
                opacity: 0;
                transform: scale(40, 40);
            }
        }

        .cursor-pointer {
            cursor: pointer !important;
        }
    </style>
</head>

@{
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    string GetActiveClasses(string targetController, string? targetAction = null)
    {
        bool isActive = string.Equals(currentController, targetController, StringComparison.OrdinalIgnoreCase);
        
        if (targetAction != null)
        {
            isActive = isActive && string.Equals(currentAction, targetAction, StringComparison.OrdinalIgnoreCase);
        }

        return isActive
                    ? "flex items-center gap-3 px-3 py-2 bg-blue-50 text-blue-700 rounded-lg font-medium border-r-4 border-blue-600 transition-all shadow-sm shadow-blue-100/50"
                    : "flex items-center gap-3 px-3 py-2 text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-lg font-medium transition-all";
    }
}

<body
    class="bg-gray-50 text-gray-800 font-sans antialiased overflow-hidden selection:bg-blue-100 selection:text-blue-900">

    <div class="flex h-screen w-full relative">

        <div id="sidebar-backdrop" class="fixed inset-0 bg-gray-900/50 z-20 hidden md:hidden transition-opacity"></div>

        <aside id="sidebar"
               class="fixed inset-y-0 left-0 w-64 bg-white border-r border-gray-200 shrink-0 flex flex-col z-30 transform -translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-in-out">

            <div class="h-16 flex items-center justify-between px-6 border-b border-gray-200">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                    <div class="bg-blue-600 p-1.5 rounded text-white shadow-sm shadow-blue-200">
                        <i data-lucide="anchor" class="w-5 h-5"></i>
                    </div>
                    <span class="text-lg font-bold text-gray-900 tracking-tight">ImportCost<span
                        class="text-blue-600">Pro</span></span>
                    </a>
                    <button id="close-sidebar-btn"
                            class="md:hidden text-gray-500 hover:bg-gray-100 p-1 rounded-md cursor-pointer">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-6 custom-scrollbar">

                    <div>
                        <p class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Operaciones</p>
                        <div class="space-y-1">
                            <a asp-controller="Home" asp-action="Index" class="@GetActiveClasses("Home", "Index")">
                                <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Panel Principal
                            </a>
                            <a asp-controller="ImportOrder" asp-action="Index" class="@GetActiveClasses("ImportOrder")">
                                <i data-lucide="package-search" class="w-5 h-5"></i> Registro de Órdenes
                            </a>
                            <a asp-controller="LandedCost" asp-action="Index" class="@GetActiveClasses("LandedCost")">
                                <i data-lucide="calculator" class="w-5 h-5"></i> Liquidación de Costos
                            </a>
                        </div>
                    </div>

                    <div>
                        <p class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Gestión de Catálogos</p>
                            <div class="space-y-1">
                                <a asp-controller="Product" asp-action="Index" class="@GetActiveClasses("Product")">
                                    <i data-lucide="box" class="w-5 h-5"></i> Catálogo de Productos
                                </a>
                                <a asp-controller="Importer" asp-action="Index" class="@GetActiveClasses("Importer")">
                                    <i data-lucide="users" class="w-5 h-5"></i> Importadores
                                </a>
                                <a asp-controller="Supplier" asp-action="Index" class="@GetActiveClasses("Supplier")">
                                    <i data-lucide="truck" class="w-5 h-5"></i> Proveedores Externos
                                </a>
                                <a asp-controller="Country" asp-action="Index" class="@GetActiveClasses("Country")">
                                    <i data-lucide="globe" class="w-5 h-5"></i> Países Registrados
                                </a>
                                <a asp-controller="Currency" asp-action="Index" class="@GetActiveClasses("Currency")">
                                    <i data-lucide="coins" class="w-5 h-5"></i> Divisas y Monedas
                                </a>
                                <a asp-controller="ExchangeRate" asp-action="Index" class="@GetActiveClasses("ExchangeRate")">
                                    <i data-lucide="trending-up" class="w-5 h-5"></i> Tasas de Cambio
                                </a>
                                <a asp-controller="TariffCategory" asp-action="Index"
                                   class="@GetActiveClasses("TariffCategory")">
                                    <i data-lucide="book-open" class="w-5 h-5"></i> Categorías Arancelarias
                                </a>
                            </div>
                        </div>

                        <div>
                            <p class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Configuración Fiscal</p>
                                <div class="space-y-1">
                                    <a asp-controller="TaxConfiguration" asp-action="Index"
                                       class="@GetActiveClasses("TaxConfiguration")">
                                        <i data-lucide="settings-2" class="w-5 h-5"></i> Tasas de Impuestos
                                    </a>
                                </div>
                            </div>

                        <div class="pt-4 mt-4 border-t border-gray-100">
                            <p class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Información</p>
                            <div class="space-y-1">
                                <a asp-controller="Home" asp-action="Credits" class="@GetActiveClasses("Home", "Credits")">
                                    <i data-lucide="award" class="w-5 h-5 text-amber-500"></i> Créditos del Proyecto
                                </a>
                            </div>
                        </div>
                    </nav>
                </aside>

                <div class="flex-1 flex flex-col h-screen overflow-hidden min-w-0">

                    <header
                        class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6 z-10 shrink-0">

                        <div class="flex items-center gap-4">
                            <button id="open-sidebar-btn"
                                    class="md:hidden p-2 text-gray-500 hover:bg-gray-100 rounded-md transition-colors cursor-pointer">
                                <i data-lucide="menu" class="w-5 h-5"></i>
                            </button>
                            <div class="hidden sm:flex items-center text-sm text-gray-500">
                                <span class="text-gray-900 font-medium">@ViewData["Title"]</span>
                            </div>
                        </div>

                        <div class="relative">
                            <button id="user-menu-btn" class="flex items-center gap-3 pl-4 border-l border-gray-200 hover:bg-gray-50 py-2 px-2 rounded-xl transition-all cursor-pointer group">
                                <div class="hidden sm:flex flex-col items-end">
                                    <span class="text-sm font-semibold text-gray-900 leading-tight">Usuario Administrador</span>
                                    <span class="text-xs text-gray-500 leading-tight">Acceso Total</span>
                                </div>
                                <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm border border-blue-700 shadow-sm shadow-blue-200 group-hover:scale-105 transition-transform">
                                    ADM
                                </div>
                                <i data-lucide="chevron-down" class="w-4 h-4 text-gray-400 group-hover:text-gray-600 transition-colors"></i>
                            </button>

                            @* Dropdown Easter Egg *@
                            <div id="user-dropdown" class="absolute right-0 mt-2 w-72 bg-white rounded-2xl shadow-2xl border border-gray-100 py-2 z-50 hidden animate__animated animate__fadeIn animate__faster">
                                <div class="px-4 py-3 border-b border-gray-50">
                                    <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Equipo de Desarrollo</p>
                                </div>

                                <div class="p-2 space-y-1">
                                    @* Lead *@
                                    <a href="https://github.com/xNeuNoRo" target="_blank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-blue-50 transition-all group">
                                        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white text-xs font-black shadow-sm shadow-blue-100">AM</div>
                                        <div class="flex-1">
                                            <span class="block text-xs font-bold text-gray-900">Angel Gonzalez Muñoz</span>
                                            <span class="block text-[10px] text-blue-600 font-bold uppercase tracking-tighter">Lead Developer</span>
                                        </div>
                                        <i data-lucide="github" class="w-4 h-4 text-gray-300 group-hover:text-blue-600 transition-colors"></i>
                                    </a>

                                    @* Isaias *@
                                    <a href="https://github.com/IsaiasMorillo" target="_blank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-emerald-50 transition-all group">
                                        <div class="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center text-white text-xs font-black shadow-sm shadow-emerald-100">IF</div>
                                        <div class="flex-1">
                                            <span class="block text-xs font-bold text-gray-900">Isaias Jose Morillo F.</span>
                                            <span class="block text-[10px] text-emerald-600 font-bold uppercase tracking-tighter">Software Developer</span>
                                        </div>
                                        <i data-lucide="github" class="w-4 h-4 text-gray-300 group-hover:text-emerald-600 transition-colors"></i>
                                    </a>

                                    @* Engel *@
                                    <a href="https://github.com/notengel" target="_blank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-50 transition-all group">
                                        <div class="w-8 h-8 rounded-lg bg-indigo-500 flex items-center justify-center text-white text-xs font-black shadow-sm shadow-indigo-100">AS</div>
                                        <div class="flex-1">
                                            <span class="block text-xs font-bold text-gray-900">Engel Orlando Acosta D.</span>
                                            <span class="block text-[10px] text-indigo-600 font-bold uppercase tracking-tighter">Software Developer</span>
                                        </div>
                                        <i data-lucide="github" class="w-4 h-4 text-gray-300 group-hover:text-indigo-600 transition-colors"></i>
                                    </a>
                                </div>
                                <div class="px-4 py-2 mt-2 border-t border-gray-50 text-center">
                                    <span class="text-[9px] font-bold text-gray-300 uppercase tracking-widest italic">Contributors</span>
                                </div>
                            </div>
                        </div>
                        </header>
                    <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50">
                        <div class="p-4 sm:p-6 md:p-8 max-w-7xl mx-auto page-entry">
                            @RenderBody()
                        </div>
                    </main>

                </div>
            </div>

            <script src="~/lib/jquery/dist/jquery.min.js"></script>

            @await RenderSectionAsync("Scripts", required: false)

            <script>
                // Inicializar los íconos de Lucide
                lucide.createIcons();

                // Lógica para el Sidebar en dispositivos móviles
                const sidebar = document.getElementById('sidebar');
                const backdrop = document.getElementById('sidebar-backdrop');
                const openBtn = document.getElementById('open-sidebar-btn');
                const closeBtn = document.getElementById('close-sidebar-btn');

                function toggleSidebar() {
                    sidebar.classList.toggle('-translate-x-full');
                    backdrop.classList.toggle('hidden');
                }

                openBtn.addEventListener('click', toggleSidebar);
                closeBtn.addEventListener('click', toggleSidebar);
                backdrop.addEventListener('click', toggleSidebar);

                // Lógica para el dropdown del usuario (Easter Egg)
                const userBtn = document.getElementById('user-menu-btn');
                const userDropdown = document.getElementById('user-dropdown');

                userBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    userDropdown.classList.toggle('hidden');
                });

                document.addEventListener('click', function(e) {
                    if (!userBtn.contains(e.target)) {
                        userDropdown.classList.add('hidden');
                    }
                });

            </script>
        </body>

    </html>
