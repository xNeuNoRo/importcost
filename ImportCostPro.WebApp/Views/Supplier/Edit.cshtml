@model ImportCostPro.Application.ViewModels.SupplierViewModels.UpdateSupplierViewModel
@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="mb-6 animate__animated animate__fadeIn">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors cursor-pointer">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Volver al listado
    </a>
    <h1 class="text-2xl font-bold text-gray-900 mt-2">Editar Proveedor</h1>
    <p class="text-sm text-gray-500">Actualice la información del proveedor y sus configuraciones base.</p>
</div>

<div class="max-w-4xl animate__animated animate__fadeInUp animate__faster">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-300">
        <form asp-action="Edit" method="post" class="p-6 sm:p-8">
            <input type="hidden" asp-for="Id" />
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm animate__animated animate__shakeX">
                </div>
            }

            <div class="space-y-8">
                @* Sección: Datos Generales *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i data-lucide="building-2" class="w-5 h-5 text-blue-600"></i>
                        Información del Proveedor
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group md:col-span-2">
                            <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"></label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="truck" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Name" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="Ej: Global Logistics Corp." />
                            </div>
                            <span asp-validation-for="Name" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="OriginCountryId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">País de Origen</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="globe" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="OriginCountryId" asp-items="ViewBag.Countries" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none cursor-pointer disabled:bg-gray-100 disabled:cursor-not-allowed" disabled="@Model.HasOrders">
                                    <option value="">Seleccione un país...</option>
                                </select>
                                @if (Model.HasOrders) { <input type="hidden" asp-for="OriginCountryId" /> }
                            </div>
                            <span asp-validation-for="OriginCountryId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="DefaultCurrencyId" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Moneda Principal</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="coins" class="w-4 h-4"></i>
                                </div>
                                <select asp-for="DefaultCurrencyId" asp-items="ViewBag.Currencies" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none cursor-pointer disabled:bg-gray-100 disabled:cursor-not-allowed" disabled="@Model.HasOrders">
                                    <option value="">Seleccione una moneda...</option>
                                </select>
                                @if (Model.HasOrders) { <input type="hidden" asp-for="DefaultCurrencyId" /> }
                            </div>
                            <span asp-validation-for="DefaultCurrencyId" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>
                    @if (Model.HasOrders)
                    {
                        <p class="mt-3 text-xs text-amber-600 flex items-center gap-1.5 font-medium bg-amber-50 p-2 rounded-lg border border-amber-100">
                            <i data-lucide="info" class="w-3.5 h-3.5"></i>
                            País y Moneda no editables por órdenes registradas.
                        </p>
                    }
                </div>

                @* Sección: Contacto *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i data-lucide="mail-check" class="w-5 h-5 text-blue-600"></i>
                        Información de Contacto
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group">
                            <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"></label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="mail" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Email" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="ventas@proveedor.com" />
                            </div>
                            <span asp-validation-for="Email" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>

                        <div class="group">
                            <label asp-for="PhoneNumber" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"></label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                                    <i data-lucide="phone" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="PhoneNumber" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm placeholder:text-gray-400 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="Ej: +1 800-555-0199" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                        </div>
                    </div>
                </div>

                @* Sección: Configuración Adicional *@
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i data-lucide="settings" class="w-5 h-5 text-blue-600"></i>
                        Configuración Adicional
                    </h3>
                    <label class="flex items-center gap-3 cursor-pointer group w-fit">
                        <div class="relative">
                            <input type="checkbox" asp-for="IsActive" class="peer sr-only" />
                            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:inset-s-0.5 after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600 transition-colors"></div>
                        </div>
                        <span id="status-text" class="text-sm font-medium text-gray-600 group-hover:text-gray-900 transition-colors">Habilitar proveedor</span>
                    </label>
                </div>
            </div>

            <div class="mt-10 pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition-all cursor-pointer">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex items-center justify-center gap-2.5 px-8 py-2.5 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-200 transition-all cursor-pointer hover-scale active:scale-95">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Actualizar Proveedor
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const statusCheckbox = document.querySelector('input[name="IsActive"]');
        const statusText = document.getElementById('status-text');

        function updateStatusText() {
            statusText.textContent = statusCheckbox.checked ? "Proveedor habilitado" : "Proveedor deshabilitado";
            statusText.classList.toggle('text-green-600', statusCheckbox.checked);
            statusText.classList.toggle('text-gray-600', !statusCheckbox.checked);
        }

        statusCheckbox.addEventListener('change', updateStatusText);
        updateStatusText();
    </script>
}
