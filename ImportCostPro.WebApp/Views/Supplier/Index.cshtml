@model IEnumerable<ImportCostPro.Application.ViewModels.SupplierViewModels.SupplierListViewModel>
@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate__animated animate__fadeIn">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Proveedores</h1>
        <p class="text-sm text-gray-500">Gestione el catálogo de proveedores internacionales y sus divisas base.</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center justify-center gap-2.5 px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-all shadow-sm shadow-blue-200 cursor-pointer hover-scale btn-fancy">
        <i data-lucide="plus" class="w-5 h-5"></i>
        Nuevo Proveedor
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3 text-green-700 shadow-sm animate__animated animate__fadeInDown">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-red-700 shadow-sm animate__animated animate__shakeX">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["ErrorMessage"]</p>
    </div>
}

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden animate__animated animate__fadeInUp animate__faster">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50/50 border-b border-gray-200">
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Proveedor</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">País / Moneda</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Contacto</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Estado</th>
                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-gray-500 italic">
                            No se encontraron proveedores registrados.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50/50 transition-colors group">
                        <td class="px-6 py-4">
                            <span class="text-sm font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">@item.Name</span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex flex-col items-center gap-1">
                                <span class="inline-flex items-center gap-1 text-xs text-gray-600">
                                    <i data-lucide="globe" class="w-3 h-3"></i>
                                    @item.CountryName
                                </span>
                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-100 text-[10px] font-black uppercase tracking-widest">
                                    <i data-lucide="coins" class="w-2.5 h-2.5"></i>
                                    @item.CurrencyIsoCode
                                </span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col gap-1">
                                @if (!string.IsNullOrEmpty(item.Email))
                                {
                                    <div class="flex items-center gap-1.5 text-xs text-gray-600">
                                        <i data-lucide="mail" class="w-3.5 h-3.5 text-gray-400"></i>
                                        @item.Email
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                {
                                    <div class="flex items-center gap-1.5 text-xs text-gray-600">
                                        <i data-lucide="phone" class="w-3.5 h-3.5 text-gray-400"></i>
                                        @item.PhoneNumber
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            @if (item.IsActive)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-200 shadow-sm">
                                    <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-200 shadow-sm">
                                    <i data-lucide="x-circle" class="w-3.5 h-3.5"></i>
                                    Inactivo
                                </span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-2">
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="inline">
                                    <button type="submit" class="p-2.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all cursor-pointer hover-scale" title="@(item.IsActive ? "Desactivar" : "Activar")">
                                        <i data-lucide="@(item.IsActive ? "toggle-right" : "toggle-left")" class="w-5 h-5"></i>
                                    </button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="p-2.5 text-gray-400 hover:text-amber-600 hover:bg-amber-50 rounded-xl transition-all cursor-pointer hover-scale" title="Editar">
                                    <i data-lucide="edit-3" class="w-5 h-5"></i>
                                </a>
                                <button type="button" onclick="confirmDelete(@item.Id, '@item.Name')" class="p-2.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all cursor-pointer hover-scale" title="Eliminar">
                                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: '¿Eliminar proveedor?',
                text: `¿Está seguro que desea eliminar al proveedor "${name}"? Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'rounded-xl px-6 py-2.5 text-sm font-bold ml-2',
                    cancelButton: 'rounded-xl px-6 py-2.5 text-sm font-bold'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '@Url.Action("Delete")';
                    
                    const idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'id';
                    idInput.value = id;
                    
                    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiForgeryToken) {
                        form.appendChild(antiForgeryToken.cloneNode());
                    }
                    
                    form.appendChild(idInput);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}
