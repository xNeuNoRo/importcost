@model ImportCostPro.Application.ViewModels.TaxConfigurationViewModels.SaveTaxConfigurationViewModel
@{
    ViewData["Title"] = "Configuración de Impuestos";
}

<div class="mb-6 animate__animated animate__fadeIn">
    <h1 class="text-2xl font-bold text-gray-900">Configuración Global de Impuestos</h1>
    <p class="text-sm text-gray-500">Defina los porcentajes base para el cálculo del Costo de Importación Liquidado en todo el sistema.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3 text-green-700 shadow-sm animate__animated animate__fadeInDown">
        <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3 text-red-700 shadow-sm animate__animated animate__shakeX">
        <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
        <p class="text-sm font-medium">@TempData["ErrorMessage"]</p>
    </div>
}

<div class="max-w-3xl animate__animated animate__fadeInUp animate__faster">
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-300">
        <div class="bg-gray-50/50 px-6 py-4 border-b border-gray-200 flex items-center gap-3">
            <div class="p-2 bg-blue-600 rounded-lg text-white">
                <i data-lucide="settings-2" class="w-5 h-5"></i>
            </div>
            <div>
                <h3 class="text-sm font-bold text-gray-900">Panel de Configuración</h3>
                <p class="text-[11px] text-gray-500 italic">Los cambios aplicados se utilizarán solo para nuevos cálculos oficiales.</p>
            </div>
        </div>

        <form asp-action="Save" method="post" class="p-6 sm:p-8">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm animate__animated animate__shakeX">
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                @* Campo: ITBIS *@
                <div class="group">
                    <label asp-for="ItbisPercentage" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Tasa General ITBIS (%)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                            <i data-lucide="percent" class="w-4 h-4"></i>
                        </div>
                        <input asp-for="ItbisPercentage" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none font-mono font-bold" placeholder="18.00" />
                    </div>
                    <span asp-validation-for="ItbisPercentage" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                    <p class="mt-2 text-[11px] text-gray-400">Porcentaje aplicado sobre la base imponible acumulada.</p>
                </div>

                @* Campo: Servicio Aduanal *@
                <div class="group">
                    <label asp-for="CustomsServiceRatePercentage" class="block text-sm font-semibold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors">Tasa Servicio Aduanal (%)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-500 transition-colors">
                            <i data-lucide="anchor" class="w-4 h-4"></i>
                        </div>
                        <input asp-for="CustomsServiceRatePercentage" class="block w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none font-mono font-bold" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="CustomsServiceRatePercentage" class="mt-1.5 text-xs text-red-600 font-medium"></span>
                    <p class="mt-2 text-[11px] text-gray-400">Porcentaje aplicado sobre el valor CIF del producto.</p>
                </div>
            </div>

            <div class="mt-10 pt-6 border-t border-gray-100 flex items-center justify-end">
                <button type="submit" class="inline-flex items-center justify-center gap-2.5 px-10 py-3 bg-blue-600 text-white text-sm font-bold rounded-xl hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-200 transition-all cursor-pointer hover-scale active:scale-95">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Guardar Configuración
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
